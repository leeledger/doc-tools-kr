{
  "$comment": "G2 A0 (Arch, 2026-10-01): LCP stays at 2,000 ms; the gate is the median of 5 runs per URL, and the CI runner result is the source of truth (local runs quantise to about 1,953 or 2,040 ms under simulated throttling). Sprint C, C2: /remove-background/ exists only in a PUBLIC_BG_REMOVE=1 build; the CI checks job builds with it on, so run lhci locally on such a build too. Aggregation is \"median\" (the median value of the 5 runs per assertion); \"median-run\" asserted every metric on one representative run picked by FCP and TTI, which is not the median LCP (G2 ci-green).",
  "ci": {
    "collect": {
      "startServerCommand": "node tests/e2e/serve.mjs",
      "startServerReadyPattern": "serve:",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/pdf-merge/",
        "http://127.0.0.1:4173/pdf-compress/",
        "http://127.0.0.1:4173/jpg-to-pdf/",
        "http://127.0.0.1:4173/photo-compress/",
        "http://127.0.0.1:4173/hwp-to-pdf/",
        "http://127.0.0.1:4173/hwp-viewer/",
        "http://127.0.0.1:4173/id-photo/",
        "http://127.0.0.1:4173/stamp-signature/",
        "http://127.0.0.1:4173/remove-background/",
        "http://127.0.0.1:4173/terms/",
        "http://127.0.0.1:4173/guide/",
        "http://127.0.0.1:4173/guide/passport-photo/",
        "http://127.0.0.1:4173/guide/pdf-merge/",
        "http://127.0.0.1:4173/guide/open-hwp-without-hangul/",
        "http://127.0.0.1:4173/guide/hwp-on-phone/",
        "http://127.0.0.1:4173/guide/what-is-hwpx/",
        "http://127.0.0.1:4173/guide/photo-sizes/",
        "http://127.0.0.1:4173/guide/admission-photo/",
        "http://127.0.0.1:4173/guide/teps-photo/",
        "http://127.0.0.1:4173/guide/stamp-image/"
      ],
      "numberOfRuns": 5,
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "chromeFlags": "--headless=new --no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.95,
            "aggregationMethod": "median"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1,
            "aggregationMethod": "median"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.01,
            "aggregationMethod": "median"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000,
            "aggregationMethod": "median"
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 30720,
            "aggregationMethod": "median"
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
