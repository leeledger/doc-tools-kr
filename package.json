{
  "name": "doc-tools-kr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/copy-vendor.mjs && node scripts/vendor-rhwp.mjs && node scripts/gen-hwp-fonts.mjs && node scripts/gen-licenses.mjs && node scripts/gen-ui-font.mjs && node scripts/gen-brand.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-vendor.mjs && node scripts/vendor-rhwp.mjs && node scripts/gen-hwp-fonts.mjs && node scripts/gen-licenses.mjs && node scripts/gen-ui-font.mjs && node scripts/gen-brand.mjs",
    "build": "astro build",
    "postbuild": "node scripts/check-dist.mjs && node scripts/gen-headers.mjs && node scripts/carry-assets.mjs && node scripts/gen-sw.mjs",
    "preview": "node tests/e2e/serve.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check:quotes": "node scripts/ops/source-watch.mjs --exact",
    "lhci": "lhci autorun",
    "smoke:assets": "node scripts/smoke-assets.mjs",
    "ping:indexnow": "node scripts/indexnow.mjs",
    "qa:visual": "node scripts/qa/visual.mjs",
    "regress:merge": "node scripts/regress/merge.mjs",
    "regress:compress": "node scripts/regress/compress.mjs",
    "regress:photo": "node scripts/regress/photo.mjs",
    "regress:hwp": "node scripts/regress/hwp.mjs",
    "regress:hwp-viewer": "node scripts/regress/hwp-viewer.mjs",
    "regress:idphoto": "node scripts/regress/idphoto.mjs"
  },
  "dependencies": {
    "@cantoo/fontkit": "2.0.12",
    "@cantoo/pdf-lib": "2.11.1",
    "@fontsource/nanum-gothic": "5.3.0",
    "@fontsource/nanum-myeongjo": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.0",
    "@fontsource/noto-serif-kr": "5.3.0",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@rhwp/core": "0.8.6",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.3.289",
    "pretendard": "1.3.9",
    "wasm-feature-detect": "1.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@napi-rs/canvas": "1.0.9",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.1",
    "astro": "7.3.5",
    "fontverter": "2.0.0",
    "jsdom": "30.1.1",
    "subset-font": "2.9.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
