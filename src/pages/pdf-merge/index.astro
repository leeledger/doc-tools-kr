---
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import AdSlot from '../../components/AdSlot.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import EngineError from '../../components/EngineError.astro';
import { toolJsonLd } from '../../data/jsonld';
import { getTool } from '../../data/tools';

const tool = getTool('pdf-merge');
const jsonLd = toolJsonLd(tool, Astro.site);
---
<Base title={tool.title} description={tool.description}>
  <JsonLd slot="head" data={jsonLd} />
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">여러 PDF 파일을 한 파일로 합칩니다. 파일은 이 기기 밖으로 나가지 않습니다.</p>
    </div>
  </section>

  <section class="tool" aria-label="PDF 합치기 도구">
    <div class="wrap narrow">
      <div id="merge-tool" class="merge" data-state="empty">
        <div class="drop" id="merge-drop">
          <input id="merge-input" class="file-input" type="file" accept="application/pdf,.pdf" multiple>
          <label class="btn primary" for="merge-input" id="merge-pick">PDF 파일 선택</label>
          <p class="drop-hint">또는 여기에 파일을 끌어다 놓으세요</p>
          <p class="drop-hint-touch">휴대폰의 「파일」 앱이나 다운로드 폴더에서 고를 수 있습니다.</p>
          <p class="privacy-note">파일은 이 기기 밖으로 전송되지 않습니다. <a href="/privacy/">개인정보 처리방침</a></p>
        </div>

        <p class="notice" id="merge-notice" hidden></p>
        <EngineError />

        <ol class="file-list" id="merge-list" aria-label="합칠 파일 목록" hidden></ol>

        <div class="merge-controls" id="merge-controls" hidden>
          <button type="button" class="btn ghost danger" id="merge-remove-bad" hidden>문제 파일 모두 빼기</button>
          <label class="check">
            <input type="checkbox" id="merge-bookmarks" checked>
            <span>파일마다 책갈피 추가</span>
          </label>
          <div class="confirm" id="merge-confirm" hidden>
            <p id="merge-confirm-text"></p>
            <div class="row">
              <button type="button" class="btn primary" id="merge-confirm-yes">계속 합치기</button>
              <button type="button" class="btn ghost" id="merge-confirm-no">취소</button>
            </div>
          </div>
          <p class="hint" id="merge-hint"></p>
        </div>

        <div class="row merge-actions" id="merge-actions" hidden>
          <button type="button" class="btn primary" id="merge-run" disabled>PDF 합치기</button>
          <input id="merge-add" class="file-input" type="file" accept="application/pdf,.pdf" multiple>
          <label class="btn ghost" for="merge-add" id="merge-add-label">파일 추가</label>
        </div>

        <div class="progress-box" id="merge-progress" hidden>
          <p id="merge-progress-text">합치는 중…</p>
          <progress id="merge-progress-bar" max="1" value="0" aria-labelledby="merge-progress-text"></progress>
          <button type="button" class="btn ghost" id="merge-cancel">취소</button>
        </div>

        <div class="result" id="merge-result" hidden>
          <p class="result-title" id="merge-headline" tabindex="-1">합친 파일이 준비되었습니다</p>
          <p class="result-summary" id="merge-summary"></p>
          <div class="row">
            <a class="btn primary" id="merge-download" download tabindex="0">내려받기</a>
            <button type="button" class="btn ghost" id="merge-reset">다른 파일 처리하기</button>
          </div>
          <p class="save-name" id="merge-save-name"></p>
          <ul class="result-notes" id="merge-notes"></ul>
          <p class="related-line">합친 파일의 용량이 크다면 <a href="/pdf-compress/">PDF 용량 줄이기</a>에서 줄일 수 있습니다.</p>
        </div>

        <p class="error-box" id="merge-error" role="alert" data-live="alert" hidden></p>
        <p class="visually-hidden" id="merge-status" aria-live="polite" data-live="status"></p>
      </div>
      <AdSlot id="pdf-merge-result" size="rect" />
    </div>
  </section>

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">사용 방법</h2>
      <ol class="steps">
        <li><strong>PDF 파일 선택</strong><span>합칠 PDF 파일을 두 개 이상 고르거나 끌어다 놓습니다.</span></li>
        <li><strong>순서 정하기</strong><span>위로·아래로 버튼이나 왼쪽 손잡이를 끌어서 파일 순서를 정합니다. 비밀번호가 걸린 파일은 비밀번호를 입력합니다.</span></li>
        <li><strong>합치고 내려받기</strong><span>합치기 버튼을 누른 뒤 내려받기로 저장합니다.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">안전한 이유</h2>
      <ul class="points">
        <li><strong>밖으로 보내지 않습니다</strong><span>합치는 작업은 이 기기 안에서 이루어집니다. 파일은 인터넷으로 보내지지 않습니다.</span></li>
        <li><strong>남기지 않습니다</strong><span>파일과 비밀번호는 이 화면을 보는 동안에만 쓰이고, 다른 파일 처리하기를 누르거나 창을 닫으면 사라집니다.</span></li>
        <li><strong>직접 확인할 수 있습니다</strong><span>한 번 써 본 뒤 비행기 모드(인터넷 끊기)로 바꾸고 다시 합쳐 보세요. 그래도 됩니다. 파일이 밖으로 나가지 않는다는 증거입니다.</span></li>
      </ul>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} />
  <div class="wrap narrow"><AdSlot id="pdf-merge-footer" size="leaderboard" /></div>
</Base>

<script>
  import { initMergeTool } from '../../tools/pdf-merge/controller';
  initMergeTool();
</script>
