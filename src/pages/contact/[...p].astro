---
// /contact/ (ADS1020 D8, D10): the email, the usual reply time and what to send when a page is wrong. Built only when the
// contact and the privacy officer are both set (OPERATOR_ON). The page text renders in the system font (.site-info; this
// folder is in SYSTEM_FONT_PATHS of scripts/lib/ui-font-chars.mjs). The address is escaped like the footer's (site.ts).
import Base from '../../layouts/Base.astro';
import { CONTACT_EMAIL, OPERATOR_ON, SITE } from '../../data/site';

export function getStaticPaths() {
  return OPERATOR_ON ? [{ params: { p: undefined } }] : [];
}

const email = CONTACT_EMAIL!;
const title = `${SITE.name} 문의 — 틀린 내용 알리기 | ${SITE.name}`;
const description = `${SITE.name}에 궁금한 점이나 안내 글의 틀린 내용을 메일로 알려 주세요. 보통 3일 안에 답장해요.`;
---
<Base title={title} description={description}>
  <div class="prose site-info">
    <div class="wrap narrow">
      <h1>문의</h1>
      <p>메일: <a href={`mailto:${email}`}>{email}</a></p>
      <p>보통 3일 안에 답장해요.</p>

      <h2>틀린 내용 알리기</h2>
      <p>안내 글이나 도구에서 틀린 곳을 보셨다면 아래 내용을 함께 보내 주세요.</p>
      <ul>
        <li>페이지 주소</li>
        <li>쓰는 기기와 앱 (예: 아이폰 카카오톡)</li>
        <li>무엇이 틀렸는지</li>
        <li>공식 출처 링크가 있으면 함께</li>
      </ul>
      <p><strong>서류 파일은 보내지 마세요.</strong> 주민등록번호 같은 개인정보가 들어 있을 수 있어요.</p>

      <p><a href="/about/">{SITE.name} 소개</a> · <a href="/privacy/">개인정보 처리방침</a></p>
    </div>
  </div>
</Base>
