---
import Base from '../layouts/Base.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, defaultDescription, liveNames } from '../data/site';
import { HOME_TITLE, LIVE_TOOLS, TOOLS } from '../data/tools';
import { guidePath, guidesBySlug } from '../data/guides';
import { toolListJsonLd } from '../data/jsonld';

// "자주 찾는 안내" (Growth G.2): six guides in this order. G2 A1: the seasonal admission-photo takes the sixth slot
// (id-photo-size stays one click away: /guide/ and /guide/photo-sizes/).
const homeGuides = await guidesBySlug(['passport-photo', 'pdf-compress', 'pdf-merge', 'photo-kb', 'gosi-photo', 'admission-photo'], 'home');

const soon = TOOLS.filter((t) => t.status !== 'live');

const home = new URL('/', Astro.site).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: home,
    inLanguage: 'ko',
    description: defaultDescription(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: home,
    description: defaultDescription(),
    logo: new URL('/brand/icon-512.png', Astro.site).href,
  },
  toolListJsonLd(LIVE_TOOLS, Astro.site),
];
---
<Base isHome skipTarget="tools" title={HOME_TITLE}>
  <JsonLd slot="head" data={jsonLd} />
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">가입 없음 · 설치 없음 · 무료</p>
      <h1>내야 하는 문서·사진, <br>용량과 규격에 딱 맞춰 드려요</h1>
      <p class="lead">지금 쓸 수 있는 도구: {liveNames()}.</p>
      <div class="hero-cta">
        <a class="btn primary" href="#tools">도구 둘러보기</a>
        <a class="btn ghost" href="/guide/">규격·용량 안내 보기</a>
      </div>
    </div>
  </section>

  <section id="tools" class="tools" aria-labelledby="tools-title">
    <div class="wrap">
      <h2 id="tools-title">자주 쓰는 서류 작업</h2>
      <p class="section-lead">공공기관·채용 사이트 제출, 사무 업무에서 가장 많이 찾는 작업을 바로 쓸 수 있습니다.</p>
      <ul class="grid">
        {LIVE_TOOLS.map((t) => (
          <li class="card live">
            <div class="icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" set:html={t.icon} />
            </div>
            <h3><a class="card-link" href={`/${t.slug}/`}>{t.name}</a></h3>
            <p>{t.summary}</p>
            <span class="status status-live">사용하기</span>
          </li>
        ))}
      </ul>
      {soon.length > 0 && (
        <div class="soon">
          <h3>준비 중</h3>
          <ul class="soon-list">
            {soon.map((t) => <li>{t.name}</li>)}
          </ul>
        </div>
      )}
    </div>
  </section>

  {homeGuides.length > 0 && (
    <section id="guides" class="home-guides" aria-labelledby="guides-title">
      <div class="wrap">
        <h2 id="guides-title">자주 찾는 안내</h2>
        <ul class="guide-grid">
          {homeGuides.map((g) => (
            <li>
              <a href={guidePath(g.id)}>{g.data.title}</a>
              <span>{g.data.answer}</span>
            </li>
          ))}
        </ul>
        <p class="more-link"><a href="/guide/">안내 모두 보기</a></p>
      </div>
    </section>
  )}

  <section id="faq" class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      <details>
        <summary>제 파일이 다른 곳에 저장되나요?</summary>
        <p>아니요. 작업한 파일은 저장하지 않고, 창을 닫으면 사라집니다.{__BG_CLOUD__ && <> 배경 지우기의 사진 처리는 <a href="/privacy/#bg">개인정보 처리방침</a>에 적어 두었습니다.</>}</p>
      </details>
      <details>
        <summary>설치나 가입이 필요한가요?</summary>
        <p>아니요. PC와 휴대폰에서 이 페이지를 열면 바로 쓸 수 있고, 모두 무료입니다.</p>
      </details>
      <details>
        <summary>휴대폰에서도 되나요?</summary>
        <p>네. 아이폰은 iOS 16.4 이상에서 쓸 수 있습니다.</p>
      </details>
      <details>
        <summary>제출처에서 파일을 받아 주지 않아요.</summary>
        <p>제출처마다 받는 용량과 형식이 다릅니다. 안내문에 적힌 최대 용량이나 사진 크기를 확인한 뒤, 그 값에 맞춰 다시 줄여 보세요.</p>
      </details>
    </div>
  </section>
</Base>
