---
import Base from '../../layouts/Base.astro';
import licenses from '../../generated/licenses.json';
import { SITE } from '../../data/site';
import { josa } from '../../lib/ui/josa';
import { HANCOM_NOTICE, TRADEMARK_NOTICE } from '../../tools/hwp-shared/messages';

interface LicenseEntry {
  name: string;
  version: string;
  license: string;
  use: string;
  homepage: string | null;
  /** `sameAs`: the same file is printed in full under an earlier entry (gen-licenses dedupes). */
  texts: { file: string; text?: string; sameAs?: string }[];
}
const list = licenses as LicenseEntry[];
---
<Base
  title={`오픈소스 라이선스 | ${SITE.name}`}
  description={`${josa(SITE.name, '이/가')} 내 폰·컴퓨터 안에서 파일을 처리하는 데 쓰는 오픈소스 소프트웨어와 글꼴의 목록, 버전, 라이선스 전문을 안내합니다.`}
>
  <div class="prose">
    <div class="wrap narrow">
      <h1>오픈소스 라이선스</h1>
      <section aria-labelledby="hwp-notice-title">
        <h2 id="hwp-notice-title">한글(HWP) 문서 관련 고지</h2>
        <p>{HANCOM_NOTICE}</p>
        <p>{TRADEMARK_NOTICE}</p>
      </section>
      <p class="meta-line">{josa(SITE.name, '은/는')} 아래 오픈소스 소프트웨어와 글꼴을 이 사이트에서 직접 제공해 사용합니다. 각 라이선스 전문은 항목을 펼쳐 볼 수 있습니다.</p>
      <table>
        <thead><tr><th scope="col">이름</th><th scope="col">버전</th><th scope="col">라이선스</th><th scope="col">용도</th></tr></thead>
        <tbody>
          {list.map((p) => (
            <tr><td>{p.name}</td><td>{p.version}</td><td>{p.license}</td><td>{p.use}</td></tr>
          ))}
        </tbody>
      </table>
      <h2>라이선스 전문</h2>
      {list.map((p) => (
        <details class="license">
          <summary>{p.name} {p.version} ({p.license})</summary>
          {p.homepage && <p><a href={p.homepage} rel="noopener">{p.homepage}</a></p>}
          {p.texts.map((t) => (
            <>
              <h3>{t.file}</h3>
              {t.sameAs ? <p>전문은 위 「{t.sameAs}」 항목에 있습니다.</p> : <pre>{t.text}</pre>}
            </>
          ))}
        </details>
      ))}
    </div>
  </div>
</Base>
