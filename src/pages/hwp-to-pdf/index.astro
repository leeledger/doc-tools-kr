---
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import AdSlot from '../../components/AdSlot.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import EngineError from '../../components/EngineError.astro';
import { faqJsonLd, toolJsonLd } from '../../data/jsonld';
import { getTool } from '../../data/tools';
import { sharePreview } from '../../data/site';
import Share from '../../components/Share.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import { COPY, HANCOM_NOTICE, TRADEMARK_NOTICE } from '../../tools/hwp-to-pdf/messages';
import '../../tools/hwp-to-pdf/hwp.css';

const tool = getTool('hwp-to-pdf');
const jsonLd = [...toolJsonLd(tool, Astro.site), faqJsonLd(tool)];
const accept = '.hwp,.hwpx,application/x-hwp,application/haansofthwp,application/vnd.hancom.hwp,application/vnd.hancom.hwpx';
---
<Base title={tool.title} description={tool.description}>
  <JsonLd slot="head" data={jsonLd} />
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">한글 프로그램 없이 한글 파일을 PDF로 바꿉니다. HWP·HWPX 문서를 고르면 모든 쪽을 미리 보여 드리고, 버튼 한 번에 PDF 파일로 내려받습니다. 한글 뷰어처럼 열어 보기만 해도 됩니다.</p>
    </div>
  </section>

  <section class="tool" aria-label="HWP PDF 변환 도구">
    <div class="wrap narrow">
      <div id="hwp-tool" class="hwp" data-state="empty">
        <p class="notice" id="hw-notice" role="status" hidden></p>
        <div class="drop" id="hw-drop">
          <input id="hw-input" class="file-input" type="file" accept={accept}>
          <label class="btn primary" for="hw-input" id="hw-pick">HWP 파일 선택</label>
          <p class="drop-hint">또는 여기에 파일을 끌어다 놓으세요</p>
          <p class="drop-hint-touch">휴대폰의 「파일」 앱이나 다운로드 폴더에서 고를 수 있습니다.</p>
          <p class="privacy-note">파일은 이 기기 밖으로 전송되지 않습니다. <a href="/privacy/">개인정보 처리방침</a></p>
        </div>

        <div class="progress-box" id="hw-progress" hidden>
          <p id="hw-progress-text">문서를 여는 중</p>
          <progress id="hw-progress-bar" aria-labelledby="hw-progress-text"></progress>
          <button type="button" class="btn ghost" id="hw-cancel">취소</button>
        </div>

        <EngineError />
        <p class="error-box" id="hw-error" role="alert" data-live="alert" tabindex="-1" hidden></p>

        <div class="hw-result" id="hw-result" hidden>
          <p class="result-title" id="hw-file-name" tabindex="-1"></p>
          <p class="notice warn" id="hw-banner" role="status" hidden></p>
          <div class="row hw-actions">
            <button type="button" class="btn primary" id="hw-save" hidden>PDF 내려받기</button>
            <button type="button" class="btn ghost" id="hw-force" hidden>그래도 PDF 내려받기</button>
            <button type="button" class="btn ghost" id="hw-reset">다른 문서 열기</button>
          </div>
          <p class="hint" id="hw-eq-note" hidden>{COPY.equations}</p>
          <p class="hint" id="hw-note" hidden>{COPY.note}</p>
          <div class="notice hw-done" id="hw-done" hidden>
            <p id="hw-done-text"></p>
            <p><a id="hw-again" download>다시 내려받기</a> · <a href="/pdf-compress/">저장한 PDF가 크면 PDF 용량 줄이기</a></p>
            <Share name={tool.name} text={sharePreview('/hwp-to-pdf/', Astro.site!).description} id="hw-share" />
          </div>
          <div class="hw-preview" id="hw-preview" tabindex="0" role="region" aria-label="문서 미리보기"></div>
        </div>

        <p class="visually-hidden" id="hw-status" aria-live="polite" data-live="status"></p>
      </div>
      <AdSlot id="hwp-to-pdf-result" size="rect" />
    </div>
  </section>

  <QuickLinks slug={tool.slug} />

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">사용 방법</h2>
      <ol class="steps">
        <li><strong>HWP 파일 고르기</strong><span>HWP·HWPX 문서를 고르거나 여기에 끌어다 놓습니다.</span></li>
        <li><strong>미리 보기</strong><span>모든 쪽을 화면에서 넘겨 볼 수 있습니다.</span></li>
        <li><strong>PDF 내려받기</strong><span>버튼을 누르면 PDF 파일이 「다운로드」 폴더에 바로 저장됩니다.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">안전한 이유</h2>
      <ul class="points">
        <li><strong>밖으로 보내지 않습니다</strong><span>문서는 이 기기 안에서만 열리고, 인터넷으로 어디에도 보내지지 않습니다.</span></li>
        <li><strong>설치하지 않습니다</strong><span>한글 프로그램이나 다른 프로그램을 설치하지 않아도 됩니다.</span></li>
        <li><strong>가입하지 않습니다</strong><span>회원가입이 필요 없습니다.</span></li>
      </ul>
    </div>
  </section>

  <section class="help" aria-labelledby="help-title">
    <div class="wrap narrow">
      <h2 id="help-title">도움말</h2>
      <h3>원본과 다를 수 있는 문서</h3>
      <ul>
        <li>수식이 들어 있는 문서는 수식 모양이 원본과 다를 수 있습니다.</li>
        <li>글상자·도형이 많은 문서는 도형의 위치가 원본과 다를 수 있습니다.</li>
        <li>100쪽 이상인 문서는 쪽 나눔이 원본과 다를 수 있습니다.</li>
      </ul>
      <p>글상자·도형이 많은 문서와 100쪽 이상인 문서는 먼저 미리보기로 보여 드립니다. 확인한 뒤 「그래도 PDF 내려받기」를 누르면 내려받을 수 있습니다.</p>
      <h3>한글(HWP) 문서 관련 고지</h3>
      <p>{HANCOM_NOTICE}</p>
      <p>{TRADEMARK_NOTICE}</p>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} only={['pdf-merge', 'pdf-compress']} />
  <div class="wrap narrow"><AdSlot id="hwp-to-pdf-footer" size="leaderboard" /></div>
  <aside class="tool-legal" aria-label="한글(HWP) 문서 관련 고지">
    <div class="wrap narrow">
      <p>{HANCOM_NOTICE}</p>
      <p>{TRADEMARK_NOTICE}</p>
    </div>
  </aside>
</Base>


<script>
  import { initHwpTool } from '../../tools/hwp-to-pdf/controller';
  initHwpTool();
</script>
