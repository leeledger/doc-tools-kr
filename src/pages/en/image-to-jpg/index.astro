---
// /en/image-to-jpg/ (EN1; the title targets "HEIC to JPG"): the Korean page's markup with English words and the same
// element ids (check-dist id parity, scripts/lib/en-check.mjs). The English controller chunk loads on the first
// interaction (src/tools/image-to-jpg/en/controller.ts). No next-step group, quick links or ad slot.
import BaseEn from '../../../layouts/BaseEn.astro';
import EngineError from '../../../components/EngineError.astro';
import RelatedTools from '../../../i18n/en/components/RelatedTools.astro';
import Share from '../../../i18n/en/components/Share.astro';
import { toolJsonLdEn } from '../../../i18n/en/jsonld';
import { sharePreviewEn } from '../../../i18n/en/site';
import { getToolEn } from '../../../i18n/en/tools';

const tool = getToolEn('image-to-jpg');
const accept = 'image/jpeg,image/png,image/webp,image/avif,image/gif,image/bmp,.jpg,.jpeg,.png,.webp,.avif,.gif,.bmp,.heic,.heif';
const groups = [
  { name: 'ij-to', legend: 'Format', options: [{ value: 'jpg', label: 'JPG' }, { value: 'png', label: 'PNG' }, { value: 'webp', label: 'WebP' }] },
  { name: 'ij-quality', legend: 'Quality', options: [{ value: 'high', label: 'High' }, { value: 'normal', label: 'Normal' }, { value: 'small', label: 'Small' }] },
];
---
<BaseEn title={tool.title} description={tool.description} jsonLd={toolJsonLdEn(tool, Astro.site)}>
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">{tool.lead}</p>
    </div>
  </section>

  <section class="tool" aria-label={`${tool.name} tool`}>
    <div class="wrap narrow">
      <div id="ij-tool" class="merge" data-state="empty">
        <div class="drop" id="ij-drop">
          <input id="ij-input" class="file-input" type="file" accept={accept} multiple>
          <label class="btn primary" for="ij-input" id="ij-pick">Choose photos</label>
          <p class="drop-hint">or drop photos here (iPhone photos, PNG, WebP, JPG and more)</p>
          <p class="drop-hint-touch">You can pick several photos from your photo library or the Files app.</p>
          <p class="privacy-note">Your photos stay on your device. Nothing is uploaded. <a href="/en/privacy/">Privacy</a></p>
        </div>

        <p class="error-box" id="ij-unsupported" role="alert" hidden>This browser cannot convert photos. Please open this page in Chrome, Safari, Edge or Firefox.</p>
        <p class="notice" id="ij-notice" hidden></p>
        <EngineError />

        <ol class="file-list no-handle" id="ij-list" aria-label="Photos to convert" hidden></ol>

        <div class="merge-controls ph-controls" id="ij-controls" hidden>
          {groups.map((g) => (
            <fieldset class="levels" id={`${g.name}-group`}>
              <legend>{g.legend}</legend>
              <div class="chips">
                {g.options.map((o, i) => (
                  <label class="chip"><input type="radio" name={g.name} value={o.value} checked={i === 0}><span>{o.label}</span></label>
                ))}
              </div>
            </fieldset>
          ))}
          <p class="hint" id="ij-hint"></p>
        </div>

        <div class="row merge-actions" id="ij-actions" hidden>
          <button type="button" class="btn primary" id="ij-run" disabled>Convert</button>
          <input id="ij-add" class="file-input" type="file" accept={accept} multiple>
          <label class="btn ghost" for="ij-add" id="ij-add-label">Add photos</label>
        </div>

        <div class="progress-box" id="ij-progress" hidden>
          <p id="ij-progress-text">Converting…</p>
          <progress id="ij-progress-bar" max="1" value="0" aria-labelledby="ij-progress-text"></progress>
          <button type="button" class="btn ghost" id="ij-cancel">Cancel</button>
        </div>

        <div class="result" id="ij-result" hidden>
          <p class="result-title" id="ij-headline" tabindex="-1">Your photo is ready</p>
          <p class="result-summary" id="ij-summary"></p>
          <div class="row">
            <a class="btn primary" id="ij-download" download tabindex="0">Download</a>
            <button type="button" class="btn ghost" id="ij-reset">Start over</button>
          </div>
          <p class="save-name" id="ij-save-name"></p>
          <Share name={tool.name} text={sharePreviewEn('/en/image-to-jpg/', Astro.site!).description} id="ij-share" />
        </div>

        <p class="error-box" id="ij-error" role="alert" data-live="alert" hidden></p>
        <p class="visually-hidden" id="ij-status" aria-live="polite" data-live="status"></p>
      </div>
    </div>
  </section>

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">How to convert HEIC to JPG</h2>
      <ol class="steps">
        <li><strong>Choose photos</strong><span>Pick the photos you want to convert, or drop them on the page. You can pick many at once.</span></li>
        <li><strong>Choose a format</strong><span>Choose JPG, PNG or WebP. For JPG and WebP, also choose the quality.</span></li>
        <li><strong>Convert and download</strong><span>Press Convert, then Download. Many photos come in one ZIP file.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">Good to know</h2>
      <ul class="points">
        <li><strong>Nothing is uploaded</strong><span>Your photos are converted on your device. Photo details such as the date and location are removed, and sideways photos are saved upright.</span></li>
        <li><strong>No install, no sign-up</strong><span>Open this page on a computer or phone and start right away.</span></li>
      </ul>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">FAQ</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} />
</BaseEn>

<script>
  import { ENGINE_EN } from '../../../i18n/en/shared';
  import { startImageToJpg } from '../../../tools/image-to-jpg/entry.ts?en';
  startImageToJpg(ENGINE_EN, () => import('../../../tools/image-to-jpg/en/controller'));
</script>
