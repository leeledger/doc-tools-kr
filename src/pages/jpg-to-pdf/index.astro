---
// /jpg-to-pdf/ (TOOLS4 T2): photos -> one PDF, in the order the user sets, on A4 or at the photo's own shape.
// The controller loads on the first interaction (entry.ts); @cantoo/pdf-lib only in its worker, when 「PDF 만들기」 runs.
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import AdSlot from '../../components/AdSlot.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import EngineError from '../../components/EngineError.astro';
import { toolJsonLd } from '../../data/jsonld';
import { getTool } from '../../data/tools';
import { sharePreview } from '../../data/site';
import Share from '../../components/Share.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import { REDUCE_EDGE } from '../../tools/jpg-to-pdf/limits';

const tool = getTool('jpg-to-pdf');
const jsonLd = toolJsonLd(tool, Astro.site);
const accept = 'image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp,.heic,.heif';
const groups = [
  { name: 'jp-page', legend: '용지', options: [{ value: 'a4', label: 'A4' }, { value: 'fit', label: '사진 크기에 맞춤' }] },
  { name: 'jp-orient', legend: 'A4 방향', options: [{ value: 'auto', label: '자동' }, { value: 'portrait', label: '세로' }] },
  { name: 'jp-margin', legend: '여백', options: [{ value: '0', label: '없음' }, { value: '10', label: '10 mm' }] },
  { name: 'jp-size', legend: '사진 크기', options: [{ value: 'original', label: '원본 그대로' }, { value: 'reduce', label: `줄이기 (긴 변 ${REDUCE_EDGE.toLocaleString('ko-KR')}픽셀)` }] },
];
---
<Base title={tool.title} description={tool.description}>
  <JsonLd slot="head" data={jsonLd} />
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">사진 여러 장을 원하는 순서로 PDF 파일 하나로 묶습니다. A4 용지에 맞추거나 사진 크기 그대로 만들 수 있습니다.</p>
    </div>
  </section>

  <section class="tool" aria-label={`${tool.name} 도구`}>
    <div class="wrap narrow">
      <div id="jp-tool" class="merge" data-state="empty">
        <div class="drop" id="jp-drop">
          <input id="jp-input" class="file-input" type="file" accept={accept} multiple>
          <label class="btn primary" for="jp-input" id="jp-pick">사진 선택</label>
          <p class="drop-hint">또는 여기에 사진을 끌어다 놓으세요 (JPG·PNG·WebP·아이폰 사진)</p>
          <p class="drop-hint-touch">휴대폰의 사진 보관함이나 「파일」 앱에서 여러 장을 고를 수 있습니다.</p>
          <p class="privacy-note">사진은 이 기기 밖으로 전송되지 않습니다. <a href="/privacy/">개인정보 처리방침</a></p>
        </div>

        <p class="error-box" id="jp-unsupported" role="alert" hidden>지금 쓰는 앱에서는 사진 PDF 변환이 안 됩니다. 아이폰은 iOS 16.4 이상으로 업데이트하거나, Chrome·Safari·삼성 인터넷 등 다른 앱으로 이 페이지를 열어 주세요.</p>
        <p class="notice" id="jp-notice" hidden></p>
        <EngineError />

        <ol class="file-list" id="jp-list" aria-label="PDF에 넣을 사진 목록" hidden></ol>

        <div class="merge-controls ph-controls" id="jp-controls" hidden>
          <button type="button" class="btn ghost danger" id="jp-remove-bad" hidden>문제 사진 모두 빼기</button>
          {groups.map((g) => (
            <fieldset class="levels" id={`${g.name}-group`}>
              <legend>{g.legend}</legend>
              <div class="chips">
                {g.options.map((o, i) => (
                  <label class="chip"><input type="radio" name={g.name} value={o.value} checked={i === 0}><span>{o.label}</span></label>
                ))}
              </div>
            </fieldset>
          ))}
          <p class="hint" id="jp-hint"></p>
        </div>

        <div class="row merge-actions" id="jp-actions" hidden>
          <button type="button" class="btn primary" id="jp-run" disabled>PDF 만들기</button>
          <input id="jp-add" class="file-input" type="file" accept={accept} multiple>
          <label class="btn ghost" for="jp-add" id="jp-add-label">사진 추가</label>
        </div>

        <div class="progress-box" id="jp-progress" hidden>
          <p id="jp-progress-text">PDF를 만드는 중…</p>
          <progress id="jp-progress-bar" max="1" value="0" aria-labelledby="jp-progress-text"></progress>
          <button type="button" class="btn ghost" id="jp-cancel">취소</button>
        </div>

        <div class="result" id="jp-result" hidden>
          <p class="result-title" id="jp-headline" tabindex="-1">PDF 파일이 준비되었습니다</p>
          <p class="result-summary" id="jp-summary"></p>
          <div class="row">
            <a class="btn primary" id="jp-download" download tabindex="0">내려받기</a>
            <button type="button" class="btn ghost" id="jp-reset">다른 사진 처리하기</button>
          </div>
          <p class="save-name" id="jp-save-name"></p>
          <Share name={tool.name} text={sharePreview('/jpg-to-pdf/', Astro.site!).description} id="jp-share" />
          <p class="related-line">PDF 용량이 크다면 <a href="/pdf-compress/">PDF 용량 줄이기</a>에서 줄이고, 다른 PDF와 묶으려면 <a href="/pdf-merge/">PDF 합치기</a>를 쓰세요.</p>
        </div>

        <p class="error-box" id="jp-error" role="alert" data-live="alert" hidden></p>
        <p class="visually-hidden" id="jp-status" aria-live="polite" data-live="status"></p>
      </div>
      <AdSlot id="jpg-to-pdf-result" size="rect" />
    </div>
  </section>

  <QuickLinks slug={tool.slug} />

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">사용 방법</h2>
      <ol class="steps">
        <li><strong>사진 선택</strong><span>PDF로 묶을 사진을 고르거나 끌어다 놓습니다. 여러 장을 한 번에 고를 수 있습니다.</span></li>
        <li><strong>순서와 용지 정하기</strong><span>위로·아래로 버튼이나 왼쪽 손잡이로 순서를 정하고, 누운 사진은 돌립니다. 용지는 A4나 사진 크기에 맞춤을 고릅니다.</span></li>
        <li><strong>만들고 내려받기</strong><span>PDF 만들기를 누른 뒤 내려받기로 저장합니다.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">알아 두면 좋아요</h2>
      <ul class="points">
        <li><strong>사진 정보는 넣지 않습니다</strong><span>촬영 위치나 날짜 같은 사진 정보는 PDF에 넣지 않고, 사진만 넣습니다.</span></li>
        <li><strong>설치·가입하지 않습니다</strong><span>PC와 휴대폰에서 이 페이지를 열면 바로 쓸 수 있습니다.</span></li>
      </ul>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
          {f.links?.map((l) => <p><a href={l.href}>{l.text}</a></p>)}
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} only={['pdf-merge', 'pdf-compress', 'photo-compress']} />
  <div class="wrap narrow"><AdSlot id="jpg-to-pdf-footer" size="leaderboard" /></div>
</Base>

<script>
  import '../../tools/jpg-to-pdf/entry';
</script>
