---
// /loan-note/ (LOAN1022): 차용증 만들기. The visitor fills the blanks (or none) and gets the same 1-page 차용증 as HWP and
// PDF, built on this device by the HWP worker from the form spec (src/data/forms/loan-note.ts); the amount is written
// in 한글 and digits in the document (src/lib/form/amount.ts). The widget is src/components/FormTool.astro (inputs
// without names, no action, submit prevented: nothing typed is stored, sent or put in the URL, L-D8). The controller
// loads after the first user signal (entry.ts). Every static string uses the preloaded UI glyphs (L-D7: no new core
// glyph); the law, with its sources, is in the tool note (src/content/tool-notes/loan-note.md), and the page says it is
// general information (L-D9).
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import ToolNotes from '../../components/ToolNotes.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import FormTool from '../../components/FormTool.astro';
import { faqJsonLd, toolJsonLd } from '../../data/jsonld';
import { getTool } from '../../data/tools';
import { LOAN_HWP, LOAN_NOTE as SPEC } from '../../data/forms/loan-note';
import { LN_PREFIX } from '../../tools/loan-note/config';
import { HANCOM_NOTICE, TRADEMARK_NOTICE } from '../../tools/hwp-shared/messages';
import { resultBlock } from '../../data/affiliate';
// Page-only styles, inlined (the /english-name/ pattern): only the form tool pages carry them.
import formCss from '../../tools/form-tool/form-tool.css?inline';

const tool = getTool('loan-note');
// 제휴 링크 (AFF1029 A2: the LinkPrice 신용정보 group; Coupang 도장 while LinkPrice is off): last in the result (FormTool `aff`).
const aff = resultBlock('loan-note', import.meta.env.PUBLIC_AFF_LINKPRICE, import.meta.env.PUBLIC_AFF_COUPANG);
const jsonLd = [...toolJsonLd(tool, Astro.site), faqJsonLd(tool)];
const groups = [
  { id: 'loan', legend: '빌린 내용', fields: ['amount', 'loanDate', 'dueDate', 'rate', 'interestDay', 'repayHow', 'terms'] },
  { id: 'lender', legend: '빌려준 사람 (채권자)', fields: ['lenderName', 'lenderBirth', 'lenderAddress', 'lenderPhone'] },
  { id: 'borrower', legend: '빌린 사람 (채무자)', fields: ['borrowerName', 'borrowerBirth', 'borrowerAddress', 'borrowerPhone'] },
];
---
<Base title={tool.title} description={tool.description}>
  <JsonLd slot="head" data={jsonLd} />
  <style slot="head" is:inline set:html={formCss}></style>
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">얼마를 빌렸는지와 돌려줄 날, 이자, 두 사람의 이름과 연락처를 쓰면 차용증을 한글(HWP)과 PDF 파일로 받을 수 있습니다. 아무것도 쓰지 않으면 인쇄해서 손으로 쓰는 빈 양식을 받을 수 있습니다.</p>
      <p class="lead" id="ln-general">이 페이지는 일반적인 안내입니다. 내 경우에 맞는지는 전문가나 공공 상담 기관에 물어보세요.</p>
    </div>
  </section>

  <section class="tool" aria-label={`${tool.name} 도구`}>
    <div class="wrap narrow">
      <FormTool spec={SPEC} prefix={LN_PREFIX} groups={groups} after={['date']} hwp={LOAN_HWP} aff={aff} />

      <section class="pa-with" id="ln-with" aria-labelledby="ln-with-title">
        <h2 id="ln-with-title">함께 준비하는 것</h2>
        <ul>
          <li><a href="/stamp-maker/">도장 만들기</a> <span>두 사람이 서명할 차용증에 찍을 도장</span></li>
          <li><a href="/id-copy/">신분증 사본 만들기</a> <span>빌려준 사람이 신분증 사본을 함께 받아 둘 때</span></li>
          <li><a href="/pdf-merge/">PDF 합치기</a> <span>차용증과 신분증 사본을 한 파일로</span></li>
        </ul>
      </section>
    </div>
  </section>

  <QuickLinks slug={tool.slug} />

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">사용 방법</h2>
      <ol class="steps">
        <li><strong>칸 채우기</strong><span>빌려준 사람(채권자)과 빌린 사람(채무자), 얼마를 빌렸는지와 돌려줄 날을 씁니다. 쓰지 않은 칸은 빈칸으로 남습니다.</span></li>
        <li><strong>차용증 만들기</strong><span>버튼을 누르면 차용증을 만들어 미리 보여 드립니다. 아무것도 쓰지 않으려면 「빈 양식으로 받기」를 누르세요.</span></li>
        <li><strong>받고 서명하기</strong><span>한글(HWP)이나 PDF로 받은 뒤 인쇄해서 두 사람이 서명하거나 도장을 찍고, 한 장씩 나눠 가집니다.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">알아 두면 좋아요</h2>
      <ul class="points">
        <li><strong>숫자로 쓰면 됩니다</strong><span>「10,000,000」처럼 숫자로 쓰면 차용증에는 한글과 숫자로 함께 들어갑니다.</span></li>
        <li><strong>이자에는 법으로 정한 한도가 있습니다</strong><span>한도와 출처는 아래 안내에 정리했습니다.</span></li>
        <li><strong>가입·설치 없이 무료</strong><span>바로 만들어 받을 수 있고, 쓴 내용은 저장하지 않습니다.</span></li>
      </ul>
    </div>
  </section>

  <ToolNotes slug={tool.slug} />

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
          {f.links?.map((l) => <p><a href={l.href}>{l.text}</a></p>)}
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} only={['stamp-maker', 'pdf-sign', 'id-copy', 'power-of-attorney', 'resignation-letter']} />
  <aside class="tool-legal" aria-label="한글(HWP) 문서 관련 고지">
    <div class="wrap narrow">
      <p>{HANCOM_NOTICE}</p>
      <p>{TRADEMARK_NOTICE}</p>
    </div>
  </aside>
</Base>

<script>
  import '../../tools/loan-note/entry';
</script>
