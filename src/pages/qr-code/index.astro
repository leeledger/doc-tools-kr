---
// /qr-code/ (CARD1026 Step B): QR코드 만들기. Six kinds of static QR (인터넷 주소, 글자, 연락처, 와이파이, 전화, 문자):
// the code holds what was typed, so it never stops working. The page ships the kind picker, the six panels and empty
// output slots; entry.ts switches panels (and reads ?tab= once, never writing it back) and loads the controller
// (uqr, payload, render: src/lib/qr) on the first interaction. Nothing typed is stored, put in the URL or sent: no
// form, no name attributes, fixed file names. QR1031: a closed 「색 바꾸기·로고 넣기」 panel under the 받기 buttons (QR and
// background color, a center picture chosen from this device, kept in memory only); opening it never moves the preview.
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import ToolNotes from '../../components/ToolNotes.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import EngineError from '../../components/EngineError.astro';
import ContactFields from '../../components/ContactFields.astro';
import { faqJsonLd, toolJsonLd } from '../../data/jsonld';
import { getTool } from '../../data/tools';
import { QR_MAX_BYTES } from '../../lib/qr/encode';
import { SMS_MAX, SSID_MAX } from '../../lib/qr/payload';
// Page-only styles, inlined (the /pdf-sign/ pattern): no other page carries them.
import cfCss from '../../styles/contact-fields.css?inline';
import qrCss from '../../tools/qr-code/qr-code.css?inline';

const tool = getTool('qr-code');
const jsonLd = [...toolJsonLd(tool, Astro.site), faqJsonLd(tool)];
// The six kinds in the brief's order (C10); ids = the ?tab= values and QrKind in src/tools/qr-code/controller.ts.
const kinds = [
  { id: 'url', label: '인터넷 주소' },
  { id: 'text', label: '글자' },
  { id: 'contact', label: '연락처' },
  { id: 'wifi', label: '와이파이' },
  { id: 'tel', label: '전화' },
  { id: 'sms', label: '문자' },
];
---
<Base title={tool.title} description={tool.description}>
  <JsonLd slot="head" data={jsonLd} />
  <style slot="head" is:inline set:html={cfCss + qrCss}></style>
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">인터넷 주소, 와이파이, 연락처, 전화, 문자, 글자를 QR코드로 만들어 PNG·SVG 그림으로 받습니다. 가입 없이 무료이고, 기간이 지나도 QR이 멈추지 않아요.</p>
    </div>
  </section>

  <section class="tool" aria-label={`${tool.name} 도구`}>
    <div class="wrap narrow">
      <div class="qr" id="qr-tool">
        <fieldset class="qr-kinds">
          <legend>QR에 담을 것</legend>
          <div class="chips">
            {kinds.map((k, i) => (
              <label class="chip"><input type="radio" name="qr-kind" value={k.id} checked={i === 0} aria-controls={`qr-p-${k.id}`}><span>{k.label}</span></label>
            ))}
          </div>
        </fieldset>

        <div class="qr-panel" id="qr-p-url" data-panel="url">
          <label for="qr-url">인터넷 주소</label>
          <input id="qr-url" class="qr-input" type="text" inputmode="url" maxlength="2000" placeholder="예: docttak.com" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="qr-url-error">
          <p class="field-error" id="qr-url-error"></p>
        </div>

        <div class="qr-panel" id="qr-p-text" data-panel="text" hidden>
          <label for="qr-text">QR에 담을 글자</label>
          <textarea id="qr-text" class="qr-input" rows="4" maxlength={QR_MAX_BYTES} autocomplete="off" spellcheck="false" aria-describedby="qr-text-error"></textarea>
          <p class="field-error" id="qr-text-error"></p>
        </div>

        <div class="qr-panel" id="qr-p-contact" data-panel="contact" hidden>
          <ContactFields prefix="qr" />
        </div>

        <div class="qr-panel" id="qr-p-wifi" data-panel="wifi" hidden>
          <label for="qr-ssid">와이파이 이름</label>
          <input id="qr-ssid" class="qr-input" type="text" maxlength={SSID_MAX} autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="qr-ssid-error">
          <p class="field-error" id="qr-ssid-error"></p>
          <fieldset class="qr-sec">
            <legend>보안 방식</legend>
            <label class="radio"><input type="radio" name="qr-sec" value="WPA" checked>WPA·WPA2·WPA3 (대부분)</label>
            <label class="radio"><input type="radio" name="qr-sec" value="WEP">WEP (오래된 공유기)</label>
            <label class="radio"><input type="radio" name="qr-sec" value="nopass">비밀번호 없음</label>
          </fieldset>
          <div class="qr-pw" id="qr-pw-box">
            <label for="qr-pw">비밀번호</label>
            <input id="qr-pw" class="qr-input" type="text" maxlength="100" autocomplete="off" autocapitalize="off" spellcheck="false" aria-describedby="qr-pw-error">
            <p class="field-error" id="qr-pw-error"></p>
          </div>
        </div>

        <div class="qr-panel" id="qr-p-tel" data-panel="tel" hidden>
          <label for="qr-tel">전화번호</label>
          <input id="qr-tel" class="qr-input" type="tel" inputmode="tel" maxlength="20" placeholder="예: 010-1234-5678" autocomplete="off" aria-describedby="qr-tel-error">
          <p class="field-error" id="qr-tel-error"></p>
        </div>

        <div class="qr-panel" id="qr-p-sms" data-panel="sms" hidden>
          <label for="qr-sms-to">받는 전화번호</label>
          <input id="qr-sms-to" class="qr-input" type="tel" inputmode="tel" maxlength="20" placeholder="예: 010-1234-5678" autocomplete="off" aria-describedby="qr-sms-to-error">
          <p class="field-error" id="qr-sms-to-error"></p>
          <label for="qr-sms-text">문자 내용</label>
          <textarea id="qr-sms-text" class="qr-input" rows="3" maxlength={SMS_MAX} autocomplete="off" spellcheck="false" aria-describedby="qr-sms-text-error"></textarea>
          <p class="field-error" id="qr-sms-text-error"></p>
        </div>

        <p class="privacy-note">쓴 내용은 이 기기 밖으로 보내지 않습니다. <a href="/privacy/">개인정보 처리방침</a></p>

        <div class="qr-out" id="qr-out" aria-labelledby="qr-out-title">
          <h2 id="qr-out-title" class="visually-hidden">만든 QR</h2>
          <div class="qr-preview is-empty" id="qr-preview"><p class="qr-empty" id="qr-empty">쓰는 대로 여기에 QR이 나와요.</p></div>
          <p class="field-error" id="qr-over" role="alert"></p>
          <p class="hint qr-dense" id="qr-dense" hidden></p>
          <div class="qr-actions">
            <button type="button" class="btn primary" id="qr-png">QR 그림 받기 (PNG)</button>
            <button type="button" class="btn ghost" id="qr-svg">SVG로 받기</button>
          </div>
          <details class="qr-style" id="qr-style">
            <summary>색 바꾸기·로고 넣기</summary>
            <div class="qr-style-body">
              <div class="qr-colors">
                <label class="qr-color" for="qr-fg"><input type="color" id="qr-fg" value="#000000" aria-describedby="qr-color-error"><span>QR 색</span></label>
                <label class="qr-color" for="qr-bg"><input type="color" id="qr-bg" value="#ffffff" aria-describedby="qr-color-error"><span>배경 색</span></label>
                <button type="button" class="btn ghost small" id="qr-color-reset">검은색·흰색으로</button>
              </div>
              <p class="field-error" id="qr-color-error" role="alert"></p>
              <div class="qr-logo">
                <input id="qr-logo-input" class="file-input" type="file" accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp,.heic,.heif" aria-describedby="qr-logo-error">
                <label for="qr-logo-input" class="btn ghost small">로고·사진 고르기</label>
                <button type="button" class="btn ghost small" id="qr-logo-remove" hidden>로고 빼기</button>
              </div>
              <p class="field-error" id="qr-logo-error" role="alert"></p>
            </div>
          </details>
          <p class="visually-hidden" id="qr-status" aria-live="polite"></p>
        </div>
      </div>
      <EngineError />
    </div>
  </section>

  <QuickLinks slug={tool.slug} />

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">사용 방법</h2>
      <ol class="steps">
        <li><strong>담을 것 고르기</strong><span>인터넷 주소, 글자, 연락처, 와이파이, 전화, 문자 가운데 하나를 고릅니다.</span></li>
        <li><strong>칸 채우기</strong><span>쓰는 대로 바로 QR이 보입니다. 잘못 쓴 칸은 아래에 알려 드립니다.</span></li>
        <li><strong>그림으로 받기</strong><span>PNG는 문서나 메신저에, SVG는 크게 인쇄할 때 씁니다.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">알아 두면 좋아요</h2>
      <ul class="points">
        <li><strong>기간이 지나도 QR이 멈추지 않아요</strong><span>QR 안에 쓴 내용이 그대로 들어 있어, 다른 곳을 거치지 않고 바로 열립니다. 담은 내용을 바꾸려면 새로 만드세요.</span></li>
        <li><strong>가입 없이 무료</strong><span>이 페이지에서 바로 만들고, 쓴 내용은 저장하지 않습니다.</span></li>
      </ul>
    </div>
  </section>

  <ToolNotes slug={tool.slug} />

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
          {f.links?.map((l) => <p><a href={l.href}>{l.text}</a></p>)}
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} only={['business-card', 'english-name', 'english-address', 'stamp-maker']} />
</Base>

<script>
  import '../../tools/qr-code/entry';
</script>
