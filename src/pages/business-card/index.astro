---
// /business-card/ (CARD1026 Step C): 전자명함 만들기. The shared contact fields (src/components/ContactFields.astro) →
// three outputs: 연락처.vcf (vCard 3.0, folded), the 연락처 QR (the same vCard unfolded; PNG/SVG) and a 명함 그림 PNG in
// two layouts and three colours to send in a messenger. The page ships the fields and empty output slots; entry.ts loads
// the controller (uqr, vCard, renderers, card layout) on the first interaction. 보내기 stays hidden until the controller
// has loaded and this device can share the picture. Nothing typed is stored, put in the URL or sent: no form, no name on
// a text field, fixed file names.
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import ToolNotes from '../../components/ToolNotes.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import EngineError from '../../components/EngineError.astro';
import ContactFields from '../../components/ContactFields.astro';
import { faqJsonLd, toolJsonLd } from '../../data/jsonld';
import { getTool } from '../../data/tools';
// Page-only styles, inlined (the /pdf-sign/ pattern): no other page carries them.
import cfCss from '../../styles/contact-fields.css?inline';
import bcCss from '../../tools/business-card/business-card.css?inline';

const tool = getTool('business-card');
const jsonLd = [...toolJsonLd(tool, Astro.site), faqJsonLd(tool)];
// Ids = CardLayout (layout.ts) and CardColor (draw.ts).
const layouts = [
  { id: 'wide', label: '가로' },
  { id: 'tall', label: '세로' },
];
const colors = [
  { id: 'navy', label: '남색' },
  { id: 'green', label: '초록' },
  { id: 'black', label: '검정' },
];
---
<Base title={tool.title} description={tool.description}>
  <JsonLd slot="head" data={jsonLd} />
  <style slot="head" is:inline set:html={cfCss + bcCss}></style>
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">이름과 연락처를 쓰면 휴대폰 연락처에 바로 넣는 연락처 파일, 연락처 QR, 메신저로 보낼 명함 그림을 한 번에 만들어요. 가입 없이 무료이고, 기간이 지나도 QR이 멈추지 않아요.</p>
    </div>
  </section>

  <section class="tool" aria-label={`${tool.name} 도구`}>
    <div class="wrap narrow">
      <div class="bc" id="bc-tool">
        <ContactFields prefix="bc" />
        <p class="privacy-note">쓴 내용은 이 기기 밖으로 보내지 않습니다. <a href="/privacy/">개인정보 처리방침</a></p>
        <p class="field-error bc-over" id="bc-over" role="alert"></p>

        <div class="bc-out" aria-labelledby="bc-card-title">
          <h2 id="bc-card-title">명함 그림</h2>
          <fieldset class="bc-pick">
            <legend>명함 모양</legend>
            <div class="chips">
              {layouts.map((l, i) => (
                <label class="chip"><input type="radio" name="bc-layout" value={l.id} checked={i === 0}><span>{l.label}</span></label>
              ))}
            </div>
          </fieldset>
          <fieldset class="bc-pick">
            <legend>색</legend>
            <div class="chips">
              {colors.map((c, i) => (
                <label class="chip"><input type="radio" name="bc-color" value={c.id} checked={i === 0}><span>{c.label}</span></label>
              ))}
            </div>
          </fieldset>
          <div class="bc-card-box is-empty" id="bc-card-box" data-layout="wide">
            <p class="bc-empty" id="bc-card-empty">쓰는 대로 여기에 명함이 나와요.</p>
            <canvas id="bc-card" width="1800" height="1000" role="img" aria-label="명함 그림 미리보기" hidden></canvas>
          </div>
          <p class="hint" id="bc-card-small" aria-live="polite"></p>
          <div class="bc-actions">
            <button type="button" class="btn primary" id="bc-card-png">명함 그림 받기</button>
            <button type="button" class="btn ghost" id="bc-share" hidden>보내기</button>
          </div>
          <p class="field-error" id="bc-share-error" role="alert"></p>
        </div>

        <div class="bc-out" aria-labelledby="bc-qr-title">
          <h2 id="bc-qr-title">연락처 QR</h2>
          <div class="bc-qr is-empty" id="bc-qr"><p class="bc-empty" id="bc-qr-empty">쓰는 대로 여기에 QR이 나와요.</p></div>
          <p class="hint">카메라로 찍으면 연락처로 저장할 수 있어요 (기기마다 화면이 다를 수 있어요).</p>
          <div class="bc-actions">
            <button type="button" class="btn primary" id="bc-qr-png">QR 그림 받기</button>
            <button type="button" class="btn ghost" id="bc-qr-svg">SVG로 받기</button>
          </div>
        </div>

        <div class="bc-out" aria-labelledby="bc-vcf-title">
          <h2 id="bc-vcf-title">연락처 파일</h2>
          <p class="hint">휴대폰에서 열면 연락처에 바로 저장할 수 있는 파일(연락처.vcf)이에요.</p>
          <div class="bc-actions">
            <button type="button" class="btn primary" id="bc-vcf">연락처 파일 받기</button>
          </div>
        </div>
        <p class="visually-hidden" id="bc-status" aria-live="polite"></p>
      </div>
      <EngineError />
    </div>
  </section>

  <QuickLinks slug={tool.slug} />

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">사용 방법</h2>
      <ol class="steps">
        <li><strong>칸 채우기</strong><span>이름이나 회사 중 하나와, 넣고 싶은 연락처만 씁니다.</span></li>
        <li><strong>명함 고르기</strong><span>가로나 세로, 색을 고르면 명함 그림이 바로 달라져요.</span></li>
        <li><strong>받거나 보내기</strong><span>명함 그림, 연락처 QR, 연락처 파일을 받거나 휴대폰에서 바로 보냅니다.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">알아 두면 좋아요</h2>
      <ul class="points">
        <li><strong>기간이 지나도 QR이 멈추지 않아요</strong><span>연락처가 QR 안에 그대로 들어 있어, 다른 곳을 거치지 않고 바로 열립니다. 연락처가 바뀌면 새로 만드세요.</span></li>
        <li><strong>가입 없이 무료</strong><span>이 페이지에서 바로 만들고, 쓴 내용은 저장하지 않습니다.</span></li>
      </ul>
    </div>
  </section>

  <ToolNotes slug={tool.slug} />

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
          {f.links?.map((l) => <p><a href={l.href}>{l.text}</a></p>)}
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} only={['qr-code', 'english-name', 'english-address', 'stamp-maker']} />
</Base>

<script>
  import '../../tools/business-card/entry';
</script>
