---
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import AdSlot from '../../components/AdSlot.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import EngineError from '../../components/EngineError.astro';
import { toolJsonLd } from '../../data/jsonld';
import { getTool } from '../../data/tools';
import { sharePreview } from '../../data/site';
import Share from '../../components/Share.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import { LEVEL_COPY, TARGET_CHIPS } from '../../tools/pdf-compress/level-copy';

const tool = getTool('pdf-compress');
const jsonLd = toolJsonLd(tool, Astro.site);

const levels = LEVEL_COPY;
const targets = TARGET_CHIPS;
---
<Base title={tool.title} description={tool.description}>
  <JsonLd slot="head" data={jsonLd} />
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">스캔하거나 사진이 들어간 PDF의 용량을 줄입니다. 글자는 그대로 두고 이미지만 줄입니다.</p>
    </div>
  </section>

  <section class="tool" aria-label="PDF 용량 줄이기 도구">
    <div class="wrap narrow">
      <div id="compress-tool" class="compress" data-state="empty" data-mode="level">
        <div class="drop" id="cmp-drop">
          <input id="cmp-input" class="file-input" type="file" accept="application/pdf,.pdf">
          <label class="btn primary" for="cmp-input" id="cmp-pick">PDF 파일 선택</label>
          <p class="drop-hint">또는 여기에 파일을 끌어다 놓으세요</p>
          <p class="drop-hint-touch">휴대폰의 「파일」 앱이나 다운로드 폴더에서 고를 수 있습니다.</p>
          <p class="privacy-note">파일은 이 기기 밖으로 전송되지 않습니다. <a href="/privacy/">개인정보 처리방침</a></p>
        </div>

        <p class="notice" id="cmp-notice" hidden></p>
        <EngineError />

        <div class="file-item file-card" id="cmp-file" hidden>
          <div class="thumb" id="cmp-thumb" aria-hidden="true"></div>
          <div class="meta">
            <p class="name" id="cmp-name"></p>
            <p class="info" id="cmp-info"></p>
            <p class="note" id="cmp-owner" hidden>보안 설정(편집 제한)이 해제된 사본이 만들어집니다</p>
          </div>
          <form class="pw" id="cmp-pw" novalidate hidden>
            <p class="pw-state" id="cmp-pw-state">이 파일은 비밀번호로 보호되어 있습니다.</p>
            <label class="pw-label" for="cmp-pw-input">비밀번호</label>
            <div class="row pw-row">
              <input class="pw-input" id="cmp-pw-input" type="password" autocomplete="off" aria-describedby="cmp-pw-state cmp-pw-error">
              <button type="button" class="btn small ghost icon-btn pw-toggle" id="cmp-pw-toggle" aria-label="비밀번호 보기" aria-pressed="false"><svg class="ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg></button>
              <button type="submit" class="btn small primary">확인</button>
            </div>
            <p class="pw-error" id="cmp-pw-error"></p>
          </form>
        </div>

        <div class="cmp-controls" id="cmp-controls" hidden>
          <fieldset class="modes">
            <legend class="visually-hidden">줄이는 방법</legend>
            <label class="radio"><input type="radio" name="cmp-mode" value="level" checked><span>품질 단계로 줄이기</span></label>
            <label class="radio"><input type="radio" name="cmp-mode" value="target"><span>목표 용량으로 줄이기</span></label>
          </fieldset>
          <div class="target-box" id="cmp-target-box" hidden>
            <p class="target-label" id="cmp-target-label">목표 용량</p>
            <div class="chips" role="radiogroup" aria-labelledby="cmp-target-label">
              {targets.map((t) => (
                <label class="chip"><input type="radio" name="cmp-target" value={t} checked={t === '10'}><span>{t} MB</span></label>
              ))}
              <label class="chip"><input type="radio" name="cmp-target" value="custom"><span>직접 입력</span></label>
            </div>
            <div class="ph-custom" id="cmp-target-custom" hidden>
              <label for="cmp-target-mb">목표 용량 (MB)</label>
              <input class="num-input" id="cmp-target-mb" type="text" inputmode="decimal" autocomplete="off" aria-describedby="cmp-target-error">
              <p class="field-error" id="cmp-target-error"></p>
            </div>
            <p class="level-desc">목표 용량 안에 들어오는 가장 선명한 결과를 찾습니다. 글자를 읽을 수 있는 선명도 (약 96 ppi) 아래로는 줄이지 않습니다.</p>
          </div>
          <fieldset class="levels" id="cmp-levels">
            <legend>압축 단계</legend>
            {levels.map((l) => (
              <div class="level">
                <label class="radio">
                  <input type="radio" name="cmp-level" value={l.value} checked={l.value === 'recommended'} aria-describedby={`cmp-desc-${l.value}`}>
                  <span>{l.label}</span>
                </label>
                <p class="level-desc" id={`cmp-desc-${l.value}`}>{l.desc}</p>
              </div>
            ))}
            <p class="levels-common">세 단계 모두 글자와 선은 그대로 두고 이미지만 줄입니다.</p>
          </fieldset>
          <details class="more" id="cmp-more">
            <summary>더 줄여야 하나요?</summary>
            <div class="level">
              <label class="radio">
                <input type="radio" name="cmp-level" value="raster" aria-describedby="cmp-desc-raster">
                <span>이미지로 변환</span>
              </label>
              <div class="warn-box" id="cmp-desc-raster" role="note">모든 쪽을 이미지로 바꿉니다 (약 150 ppi). 글자를 선택하거나 검색할 수 없게 되고, 입력 칸·링크·책갈피가 사라집니다. 글자 위주 문서는 오히려 커질 수 있으며, 그때는 원본을 그대로 둡니다.</div>
            </div>
          </details>
          <div class="confirm" id="cmp-confirm" hidden>
            <p id="cmp-confirm-text"></p>
            <div class="row">
              <button type="button" class="btn primary" id="cmp-confirm-yes">계속 줄이기</button>
              <button type="button" class="btn ghost" id="cmp-confirm-no">취소</button>
            </div>
          </div>
          <div class="row">
            <button type="button" class="btn primary" id="cmp-run" disabled>PDF 용량 줄이기</button>
          </div>
          <p class="hint" id="cmp-hint"></p>
        </div>

        <div class="progress-box" id="cmp-progress" hidden>
          <p id="cmp-progress-text">파일 분석 중…</p>
          <progress id="cmp-progress-bar" aria-labelledby="cmp-progress-text"></progress>
          <button type="button" class="btn ghost" id="cmp-cancel">취소</button>
        </div>

        <div class="result" id="cmp-result" hidden>
          <p class="result-title" id="cmp-headline" tabindex="-1"></p>
          <p class="result-summary" id="cmp-summary"></p>
          <p class="target-chip" id="cmp-chip" hidden></p>
          <div class="row">
            <a class="btn primary" id="cmp-download" download tabindex="0">내려받기</a>
            <button type="button" class="btn ghost" id="cmp-reset">다른 파일 처리하기</button>
            <button type="button" class="btn ghost" id="cmp-again">다른 단계로 다시 줄이기</button>
          </div>
          <p class="save-name" id="cmp-save-name"></p>
          <Share name={tool.name} text={sharePreview('/pdf-compress/', Astro.site!).description} id="cmp-share" />
          <div class="warn-box" id="cmp-miss" role="note" hidden></div>
          <div class="warn-box" id="cmp-signed" role="note" hidden>이 파일에는 전자서명이 들어 있습니다. 용량을 줄인 파일에서는 서명이 더 이상 유효하지 않습니다. 발급받은 증명서처럼 서명이 필요한 문서는 원본을 제출하세요.</div>
          <ul class="result-notes" id="cmp-notes"></ul>
          <details class="pv-details" open>
            <summary>미리보기</summary>
            <div class="previews" id="cmp-previews"></div>
          </details>
          <p class="related-line">여러 파일을 하나로 묶으려면 <a href="/pdf-merge/">PDF 합치기</a></p>
          <p class="related-line">사진 파일이라면 <a href="/photo-compress/">사진 용량 줄이기</a>에서 KB에 맞춰 줄일 수 있습니다.</p>
        </div>

        <div class="kept" id="cmp-kept" hidden>
          <div id="cmp-kept-text" tabindex="-1"></div>
          <div class="row">
            <button type="button" class="btn primary" id="cmp-strong" hidden>강력으로 다시 줄이기</button>
            <button type="button" class="btn ghost" id="cmp-kept-again">다른 단계로 다시 줄이기</button>
            <button type="button" class="btn ghost" id="cmp-kept-reset">다른 파일 처리하기</button>
          </div>
        </div>

        <p class="error-box" id="cmp-error" role="alert" data-live="alert" hidden></p>
        <p class="visually-hidden" id="cmp-status" aria-live="polite" data-live="status"></p>
      </div>
      <AdSlot id="pdf-compress-result" size="rect" />
    </div>
  </section>

  <QuickLinks slug={tool.slug} />

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">사용 방법</h2>
      <ol class="steps">
        <li><strong>파일 선택</strong><span>줄일 PDF 파일을 고르거나 끌어다 놓습니다. 비밀번호가 걸린 파일은 비밀번호를 입력합니다.</span></li>
        <li><strong>단계나 목표 용량 고르기</strong><span>고화질·권장·강력 중에서 고르거나, 제출처의 용량 제한(예: 10 MB)을 목표 용량으로 고릅니다. 제출용 서류라면 권장이 알맞습니다.</span></li>
        <li><strong>내려받기</strong><span>PDF 용량 줄이기를 누르고, 줄어든 용량과 미리보기를 확인한 뒤 내려받기로 저장합니다.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">알아 두면 좋아요</h2>
      <ul class="points">
        <li><strong>남기지 않습니다</strong><span>파일과 비밀번호는 이 화면을 보는 동안에만 쓰이고, 다른 파일 처리하기를 누르거나 창을 닫으면 사라집니다.</span></li>
        <li><strong>설치·가입하지 않습니다</strong><span>PC와 휴대폰에서 이 페이지를 열면 바로 쓸 수 있습니다.</span></li>
      </ul>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} />
  <div class="wrap narrow"><AdSlot id="pdf-compress-footer" size="leaderboard" /></div>
</Base>

<script>
  import { initCompressTool } from '../../tools/pdf-compress/controller';
  initCompressTool();
</script>
