---
import Base from '../layouts/Base.astro';
import { LIVE_TOOLS } from '../data/tools';
import { SITE } from '../data/site';
import { guidePath, guidesBySlug, publishedGuides } from '../data/guides';

// "많이 찾는 안내" (Growth G.3): five guides.
const popular = await guidesBySlug(['passport-photo', 'pdf-compress', 'pdf-merge', 'photo-kb', 'id-photo-size'], '404');
// The suggestion map: only live tools and published guides.
const live = new Set(LIVE_TOOLS.map((t) => `/${t.slug}/`));
const guides = await publishedGuides();
const published = new Set(guides.map((g) => guidePath(g.id)));
const nameOf = (href: string): string =>
  LIVE_TOOLS.find((t) => `/${t.slug}/` === href)?.name ?? guides.find((g) => guidePath(g.id) === href)?.data.title ?? '문서·사진 제출 안내';
const map = (
  [
    [['hwp', '한글'], '/hwp-to-pdf/'],
    [['passport', '여권'], '/guide/passport-photo/'],
    [['merge', '합치'], '/pdf-merge/'],
    [['compress', '용량'], '/pdf-compress/'],
    [['photo', '사진'], '/photo-compress/'],
    [['guide', 'guides'], '/guide/'],
  ] as const
)
  .filter(([, href]) => live.has(href) || published.has(href) || (href === '/guide/' && guides.length > 0))
  .map(([tokens, href]) => ({ tokens: [...tokens], href, name: nameOf(href) }));
---
<Base title={`페이지를 찾을 수 없습니다 | ${SITE.name}`} description={`요청하신 페이지를 찾을 수 없습니다. 주소를 확인하시거나 ${SITE.name} 첫 화면에서 필요한 도구를 찾아 주세요.`} noindex>
  <div class="prose">
    <div class="wrap narrow">
      <h1>페이지를 찾을 수 없습니다</h1>
      <p>주소가 바뀌었거나 없는 페이지입니다. 지금 쓸 수 있는 도구로 바로 가거나 첫 화면으로 돌아가 주세요.</p>
      <p class="nf-suggest" id="nf-suggest" hidden>혹시 이 페이지를 찾으셨나요? <a href="/"></a></p>
      <ul class="nf-tools">
        {LIVE_TOOLS.map((t) => <li><a href={`/${t.slug}/`}>{t.name}</a></li>)}
      </ul>
      {popular.length > 0 && (
        <>
          <h2>많이 찾는 안내</h2>
          <ul class="nf-tools nf-guides">
            {popular.map((g) => <li><a href={guidePath(g.id)}>{g.data.title}</a></li>)}
          </ul>
        </>
      )}
      <p><a class="btn primary" href="/">첫 화면으로</a></p>
    </div>
  </div>
  <script is:inline type="application/json" id="nf-map" set:html={JSON.stringify(map).replaceAll('<', '\u003c')} />
</Base>

<script>
  import '../lib/ui/notfound';
</script>
