---
// /resignation-letter/ (RESIGN1027): 사직서 만들기. The visitor fills the blanks (or none) and gets the same 1-page 사직서
// as HWP and PDF, built on this device by the HWP worker from the form spec (src/data/forms/resignation-letter.ts). The
// 그만두는 이유 presets (R5) are buttons under the field; the entry fills the field on a press, before or after the
// controller loads. The widget is src/components/FormTool.astro (inputs without names, no action, submit prevented:
// nothing typed is stored, sent or put in the URL, R9). Every static string uses the preloaded UI glyphs (R10: no new
// core glyph); the law, with its sources, is in the tool note (src/content/tool-notes/resignation-letter.md), and the
// page says it is general information with the 고용24 / 1350 pointer (R8).
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import ToolNotes from '../../components/ToolNotes.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import FormTool from '../../components/FormTool.astro';
import { faqJsonLd, toolJsonLd } from '../../data/jsonld';
import { getTool } from '../../data/tools';
import { RESIGN_HWP, RESIGNATION_LETTER as SPEC } from '../../data/forms/resignation-letter';
import { RS_PREFIX } from '../../tools/resignation-letter/config';
import { HANCOM_NOTICE, TRADEMARK_NOTICE } from '../../tools/hwp-shared/messages';
// Page-only styles, inlined (the /english-name/ pattern): only the form tool pages carry them; the preset buttons'
// rules (form-presets.css) only on a page whose form has presets.
import formCss from '../../tools/form-tool/form-tool.css?inline';
import presetsCss from '../../tools/form-tool/form-presets.css?inline';

/** 고용24 home (handoff/sources/resign1027/work24-home.txt, 2026-10-27): a link target only. */
const WORK24_URL = 'https://www.work24.go.kr/cm/main.do';
const tool = getTool('resignation-letter');
const jsonLd = [...toolJsonLd(tool, Astro.site), faqJsonLd(tool)];
const groups = [
  { id: 'me', legend: '내 정보', fields: ['dept', 'position', 'name', 'birth', 'phone'] },
  { id: 'work', legend: '일한 기간과 이유', fields: ['joinDate', 'leaveDate', 'reason'] },
  { id: 'send', legend: '내는 날과 받는 사람', fields: ['date', 'to'] },
];
---
<Base title={tool.title} description={tool.description}>
  <JsonLd slot="head" data={jsonLd} />
  <style slot="head" is:inline set:html={formCss + presetsCss}></style>
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">부서와 이름, 그만두는 날과 이유를 쓰면 사직서를 한글(HWP)과 PDF 파일로 받을 수 있습니다. 아무것도 쓰지 않으면 인쇄해서 손으로 쓰는 빈 양식을 받을 수 있습니다.</p>
      <p class="lead" id="rs-general">이 페이지는 일반적인 안내이고, 만든 사직서는 일반 양식입니다. 내 경우에 맞는지는 <a href={WORK24_URL} rel="noopener">고용24</a>나 고용노동부 고객상담센터(국번없이 1350)에 물어보세요.</p>
    </div>
  </section>

  <section class="tool" aria-label={`${tool.name} 도구`}>
    <div class="wrap narrow">
      <FormTool spec={SPEC} prefix={RS_PREFIX} groups={groups} after={[]} hwp={RESIGN_HWP} />

      <section class="pa-with" id="rs-with" aria-labelledby="rs-with-title">
        <h2 id="rs-with-title">함께 준비하는 것</h2>
        <ul>
          <li><a href="/stamp-maker/">도장 만들기</a> <span>사직서 이름 옆에 찍을 도장</span></li>
          <li><a href="/stamp-signature/">전자서명·도장 이미지 만들기</a> <span>파일로 낼 때 넣을 서명 그림</span></li>
        </ul>
      </section>
    </div>
  </section>

  <QuickLinks slug={tool.slug} />

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">사용 방법</h2>
      <ol class="steps">
        <li><strong>칸 채우기</strong><span>내 정보와 입사일, 그만두는 날을 쓰고 그만두는 이유를 고르거나 씁니다. 쓰지 않은 칸은 빈칸으로 남습니다.</span></li>
        <li><strong>사직서 만들기</strong><span>버튼을 누르면 사직서를 만들어 미리 보여 드립니다. 아무것도 쓰지 않으려면 「빈 양식으로 받기」를 누르세요.</span></li>
        <li><strong>받고 서명하기</strong><span>한글(HWP)이나 PDF로 받은 뒤 인쇄해서 이름 옆에 서명하거나 도장을 찍어 회사에 냅니다.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">알아 두면 좋아요</h2>
      <ul class="points">
        <li><strong>이유는 골라도 됩니다</strong><span>「개인 사정」, 「이직」, 「회사 권고」 같은 버튼을 누르면 칸에 들어가고, 들어간 글은 고쳐 쓸 수 있습니다.</span></li>
        <li><strong>날짜를 비워 두면 빈칸으로</strong><span>그만두는 날을 아직 정하지 않았다면 비워 두고, 인쇄한 뒤 손으로 쓰면 됩니다.</span></li>
        <li><strong>가입·설치 없이 무료</strong><span>바로 만들어 받을 수 있고, 쓴 내용은 저장하지 않습니다.</span></li>
      </ul>
    </div>
  </section>

  <ToolNotes slug={tool.slug} />

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
          {f.links?.map((l) => <p><a href={l.href}>{l.text}</a></p>)}
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} only={['stamp-maker', 'stamp-signature', 'pdf-sign', 'loan-note', 'power-of-attorney']} />
  <aside class="tool-legal" aria-label="한글(HWP) 문서 관련 고지">
    <div class="wrap narrow">
      <p>{HANCOM_NOTICE}</p>
      <p>{TRADEMARK_NOTICE}</p>
    </div>
  </aside>
</Base>

<script>
  import '../../tools/resignation-letter/entry';
</script>
