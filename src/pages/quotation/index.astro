---
// /quotation/ (QUOTE1112): 견적서·거래명세서 만들기. The visitor picks 견적서 or 거래명세서, fills the two parties and the
// item rows (or nothing) and gets a 1-page HWP and PDF built on this device by the HWP worker from the form spec
// (src/data/forms/quotation.ts); 공급가액·세액·합계 and 「일금 …원정」 come from src/lib/form/ledger.ts, on the page (the
// totals box) and in the worker. An optional 직인 picture (a file, or from 도장 만들기's 「견적서에 찍기」) is placed at the
// sign line. The widget is src/components/FormTool.astro (inputs without names except the radio groups, no action,
// submit prevented: nothing typed is stored, sent or put in the URL, Q11). Q1: never called official, never a
// 세금계산서 (the #qt-not-tax line, with the 홈택스 link). The law, with its sources, is in the tool note.
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import ToolNotes from '../../components/ToolNotes.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import FormTool from '../../components/FormTool.astro';
import { faqJsonLd, toolJsonLd } from '../../data/jsonld';
import { getTool } from '../../data/tools';
import { QUOTE_HWP, QUOTATION as SPEC } from '../../data/forms/quotation';
import { QT_PREFIX, QT_ROWS_SHOWN } from '../../tools/quotation/config';
import { HANCOM_NOTICE, TRADEMARK_NOTICE } from '../../tools/hwp-shared/messages';
import { resultBlock } from '../../data/affiliate';
// Page-only styles, inlined (the /english-name/ pattern): the form tool rules, the 비고 preset buttons and the item rows.
import formCss from '../../tools/form-tool/form-tool.css?inline';
import presetsCss from '../../tools/form-tool/form-presets.css?inline';
import itemsCss from '../../tools/form-tool/form-items.css?inline';

/** 국세청 홈택스 (Q1): a link target only, no claim about its rules. */
const HOMETAX_URL = 'https://www.hometax.go.kr/';
const tool = getTool('quotation');
// 제휴 링크 (Q14): the LinkPrice 전자서명 group (Coupang 도장 while LinkPrice is off), last in the result.
const aff = resultBlock('quotation', import.meta.env.PUBLIC_AFF_LINKPRICE, import.meta.env.PUBLIC_AFF_COUPANG);
const jsonLd = [...toolJsonLd(tool, Astro.site), faqJsonLd(tool)];
const groups = [
  { id: 'me', legend: '우리 쪽 (공급자)', fields: ['bizNo', 'bizName', 'ceo', 'address', 'bizType', 'bizItem', 'phone'] },
  { id: 'to', legend: '받는 쪽 (공급받는자)', fields: ['recvName', 'recvBizNo', 'recvPhone'] },
  { id: 'items', legend: '품목과 부가세', fields: ['vat'], items: { shown: QT_ROWS_SHOWN } },
  { id: 'end', legend: '비고와 작성일', fields: ['note', 'date'] },
];
const specs = [
  { id: 'quotation', label: '견적서' },
  { id: 'transaction-statement', label: '거래명세서' },
];
---
<Base title={tool.title} description={tool.description}>
  <JsonLd slot="head" data={jsonLd} />
  <style slot="head" is:inline set:html={formCss + presetsCss + itemsCss}></style>
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">상호와 품목, 수량, 단가를 쓰면 부가세와 합계를 계산해 견적서나 거래명세서를 한글(HWP)과 PDF 파일로 받을 수 있습니다. 아무것도 쓰지 않으면 인쇄해서 손으로 쓰는 빈 양식을 받을 수 있습니다.</p>
    </div>
  </section>

  <section class="tool" aria-label={`${tool.name} 도구`}>
    <div class="wrap narrow">
      <FormTool spec={SPEC} specs={specs} prefix={QT_PREFIX} groups={groups} after={[]} hwp={QUOTE_HWP} aff={aff} presetsLabel="자주 쓰는 말">
        <div class="pa-seal" id="qt-seal" slot="caution">
          <label for="qt-seal-file"><strong>직인 그림 넣기 (선택)</strong></label>
          <p class="hint" id="qt-seal-hint">PNG나 JPG 그림을 고르면 서류의 공급자 이름 옆에 찍혀요.</p>
          <div class="pa-seal-row">
            <input type="file" id="qt-seal-file" accept="image/png,image/jpeg" aria-describedby="qt-seal-hint qt-seal-error">
            <img id="qt-seal-img" alt="넣은 직인 그림" hidden>
            <button type="button" class="btn ghost" id="qt-seal-remove" hidden>빼기</button>
          </div>
          <p class="field-error" id="qt-seal-error" role="alert"></p>
          <p class="hint" id="qt-seal-note"></p>
          <p><a href="/stamp-maker/">직인 그림이 없으면 도장 만들기</a></p>
          <p class="notice" id="qt-not-tax">이 서류는 세금계산서가 아닙니다. 세금계산서는 따로 발급해야 합니다. <a href={HOMETAX_URL} rel="noopener">국세청 홈택스</a></p>
        </div>
      </FormTool>

      <section class="pa-with" id="qt-with" aria-labelledby="qt-with-title">
        <h2 id="qt-with-title">함께 쓰는 것</h2>
        <ul>
          <li><a href="/stamp-maker/">도장 만들기</a> <span>견적서에 찍을 직인 그림</span></li>
          <li><a href="/pdf-sign/">PDF 서명·도장 넣기</a> <span>받은 PDF에 서명이나 도장 넣기</span></li>
        </ul>
      </section>
    </div>
  </section>

  <QuickLinks slug={tool.slug} />

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">사용 방법</h2>
      <ol class="steps">
        <li><strong>서류 고르고 칸 채우기</strong><span>견적서나 거래명세서를 고르고, 우리 쪽과 받는 쪽, 품목과 수량, 단가를 씁니다. 쓰지 않은 칸은 빈칸으로 남습니다.</span></li>
        <li><strong>부가세 고르기</strong><span>「부가세 별도」, 「부가세 포함」, 「부가세 없음」 가운데 하나를 고르면 아래 합계가 그에 맞게 새로 계산됩니다.</span></li>
        <li><strong>만들고 받기</strong><span>만들기 버튼을 누르면 미리 보여 드리고, 한글(HWP)이나 PDF로 받습니다. 아무것도 쓰지 않으려면 「빈 양식으로 받기」를 누르세요.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">알아 두면 좋아요</h2>
      <ul class="points">
        <li><strong>합계는 자동으로</strong><span>줄마다 수량과 단가로 값을 내고 원 아래는 버립니다. 합계는 「일금 …원정」으로도 들어갑니다.</span></li>
        <li><strong>직인은 그림으로</strong><span>도장 그림을 넣으면 공급자 이름 옆에 찍히고, 넣지 않으면 「(인)」 자리가 남아 인쇄한 뒤 찍을 수 있습니다.</span></li>
        <li><strong>가입·설치 없이 무료</strong><span>바로 만들어 받을 수 있고, 쓴 내용은 저장하지 않습니다.</span></li>
      </ul>
    </div>
  </section>

  <ToolNotes slug={tool.slug} />

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
          {f.links?.map((l) => <p><a href={l.href}>{l.text}</a></p>)}
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} only={['stamp-maker', 'pdf-sign', 'stamp-signature', 'loan-note', 'power-of-attorney', 'resignation-letter']} />
  <aside class="tool-legal" aria-label="한글(HWP) 문서 관련 고지">
    <div class="wrap narrow">
      <p>{HANCOM_NOTICE}</p>
      <p>{TRADEMARK_NOTICE}</p>
    </div>
  </aside>
</Base>

<script>
  import '../../tools/quotation/entry';
</script>
