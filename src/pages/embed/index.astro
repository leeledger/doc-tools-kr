---
// 무료 임베드 위젯 안내 (REV5 Decision 6): what the widget is, a live preview on demand, the snippet with a copy button, the
// conditions and the white-label contact. ADS1020 D12: noindex and out of the sitemap (llms.txt keeps its line), never
// precached (gen-sw NOT_PRECACHED). The
// text renders in the system font (.guide-page, app.css), and the copy uses characters the UI font already has. Inline
// style attributes, not a page stylesheet: a second render-blocking CSS file put local LCP at 1,962 ms.
import Base from '../../layouts/Base.astro';
import { CONTACT_EMAIL, SITE } from '../../data/site';
import { EMBED_HEIGHT, embedSnippet } from '../../data/embed';

const snippet = embedSnippet(Astro.site!);
const preview = new URL('/embed/id-photo/', Astro.site).pathname;
const description = '사진관·학원·행정사 누리집에 증명사진 규격 맞추기 도구를 무료로 넣어 보세요. 코드만 넣으면 되고, 사진은 손님 기기 밖으로 나가지 않아요.';
---
<Base title={`내 누리집에 증명사진 도구 넣기 (무료) | ${SITE.name}`} description={description} ogDescription={description} noindex>
  <div class="prose guide-page">
    <div class="wrap narrow">
      <h1>내 누리집에 증명사진 도구 넣기 (무료)</h1>
      <p>사진관·학원·행정사 누리집에 {SITE.name}의 여권·증명사진 규격 맞추기 도구를 그대로 넣을 수 있어요. 손님은 그 누리집 안에서 사진을 제출처 규격에 맞추고 바로 내려받아요. 사진은 손님 기기 밖으로 나가지 않아요.</p>

      <h2>이런 곳에 좋아요</h2>
      <ul>
        <li>사진관: 손님이 집에서 찍은 사진을 미리 규격에 맞춰 볼 수 있어요.</li>
        <li>학원: 시험 원서에 낼 증명사진을 수강생이 직접 맞출 수 있어요.</li>
        <li>행정사: 여권·자격증 서류에 쓸 사진을 손님이 바로 준비할 수 있어요.</li>
      </ul>

      <h2>넣는 방법</h2>
      <p>아래 코드를 누리집의 글이나 페이지 HTML에 그대로 넣으세요. 높이는 {EMBED_HEIGHT}을 그대로 두는 것이 좋아요. 화면이 작으면 도구 안에서 위아래로 넘겨 볼 수 있어요.</p>
      <pre id="embed-code" style="white-space:pre-wrap;overflow-wrap:anywhere;font-size:13px;line-height:1.5;padding:12px 14px;border:1px solid var(--line);border-radius:10px" tabindex="0" aria-label="넣을 코드"><code>{snippet}</code></pre>
      <div class="row">
        <button type="button" class="btn primary" id="embed-copy" data-done="코드를 복사했어요." data-fail="코드를 선택했어요. 길게 누르거나 Ctrl+C로 복사해 주세요.">코드 복사</button>
      </div>
      <p class="level-desc" id="embed-copy-status" aria-live="polite"></p>

      <h2>조건</h2>
      <ul>
        <li>무료예요.</li>
        <li>도구 아래의 「{SITE.name} 제공」 링크를 지우거나 가리지 말아 주세요.</li>
        <li>도구는 바뀌거나 멈출 수 있어요.</li>
      </ul>
      <p>로고를 바꾸거나 {SITE.name} 표시를 빼고 싶으면 메일로 알려 주세요.{CONTACT_EMAIL && <> <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></>}</p>
      <p>자세한 내용은 <a href="/terms/">이용약관</a>을 보세요.</p>

      <h2>미리 보기</h2>
      {/* On demand: a frame on this short page loads at once even with loading=lazy, and its requests put local LCP at
          1,962 ms. Without JavaScript the link opens the widget itself. */}
      <p id="embed-preview-row"><a class="btn ghost" id="embed-preview-open" href={preview} data-title={`증명사진 규격 맞추기 (${SITE.name}) 미리 보기`} data-height={EMBED_HEIGHT}>미리 보기 열기</a></p>
    </div>
  </div>
</Base>


<script>
  // 미리 보기 열기: the widget frame is made only when asked for.
  const open = document.getElementById('embed-preview-open') as HTMLAnchorElement | null;
  const row = document.getElementById('embed-preview-row');
  if (open && row) {
    open.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.className = 'embed-preview';
      frame.src = open.href;
      frame.title = open.dataset.title ?? '';
      frame.width = '100%';
      frame.height = open.dataset.height ?? '';
      frame.style.cssText = 'display:block;border:1px solid var(--line);border-radius:10px;max-width:720px';
      row.replaceWith(frame);
      frame.focus();
    });
  }

  // 코드 복사: the clipboard when allowed; otherwise (or on failure) the code is selected for a manual copy. Without
  // JavaScript the code stays selectable.
  const btn = document.getElementById('embed-copy');
  const code = document.getElementById('embed-code');
  const status = document.getElementById('embed-copy-status');
  if (btn && code && status) {
    const select = (): void => {
      const range = document.createRange();
      range.selectNodeContents(code);
      const sel = window.getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
    };
    btn.addEventListener('click', () => {
      const say = (key: 'done' | 'fail'): void => {
        status.textContent = btn.dataset[key] ?? '';
      };
      const text = code.textContent ?? '';
      const fail = (): void => {
        select();
        say('fail');
      };
      if (!navigator.clipboard?.writeText) return fail();
      navigator.clipboard.writeText(text).then(() => say('done'), fail);
    });
  }
</script>
