---
// /power-of-attorney/ (FORM1020): 위임장 만들기. The visitor fills the blanks (or none, D6) and gets the same document as
// HWP and PDF, built on this device by the HWP worker from the form spec (src/data/forms). The inputs have no name
// attributes, the form has no action and its submit is prevented: nothing typed is stored, sent or put in the URL (D7).
// The controller (with the worker, the preview and the downloads) loads after the first user signal (entry.ts). Every
// static string uses the preloaded UI glyphs (no new core glyph); the controller's lines are late copy.
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import EngineError from '../../components/EngineError.astro';
import { faqJsonLd, toolJsonLd } from '../../data/jsonld';
import { getTool } from '../../data/tools';
import { FORM_HWP, POWER_OF_ATTORNEY as SPEC } from '../../data/forms/power-of-attorney';
import { GOV24_INGAM_URL } from '../../tools/power-of-attorney/sources';
import { HANCOM_NOTICE, TRADEMARK_NOTICE } from '../../tools/hwp-shared/messages';
// Page-only styles, inlined (the /english-name/ pattern): no other page carries them.
import paCss from '../../tools/power-of-attorney/power-of-attorney.css?inline';

const tool = getTool('power-of-attorney');
const jsonLd = [...toolJsonLd(tool, Astro.site), faqJsonLd(tool)];
const field = (id: string) => {
  const f = SPEC.fields.find((x) => x.id === id);
  if (!f) throw new Error(`power-of-attorney: no field ${id}`);
  return f;
};
const groups = [
  { id: 'giver', legend: '위임하는 사람 (위임인)', fields: ['giverName', 'giverBirth', 'giverAddress', 'giverPhone'] },
  { id: 'agent', legend: '대신 가는 사람 (대리인)', fields: ['agentName', 'agentBirth', 'agentAddress', 'agentPhone', 'agentRelation'] },
  { id: 'task', legend: '위임할 일', fields: ['submitTo', 'task'] },
].map((g) => ({ ...g, fields: g.fields.map(field) }));
const date = field('date');
const task = field('task');
---
<Base title={tool.title} description={tool.description}>
  <JsonLd slot="head" data={jsonLd} />
  <style slot="head" is:inline set:html={paCss}></style>
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">위임하는 사람과 대리인, 위임할 일을 쓰면 위임장을 한글(HWP)과 PDF 파일로 받을 수 있습니다. 아무것도 쓰지 않으면 인쇄해서 손으로 쓰는 빈 양식을 받을 수 있습니다.</p>
    </div>
  </section>

  <section class="tool" aria-label={`${tool.name} 도구`}>
    <div class="wrap narrow">
      <div id="pa-tool" class="pa" data-state="empty">
        <form class="pa-form" id="pa-form" novalidate autocomplete="off">
          {groups.map((g) => (
            <fieldset class="pa-group" id={`pa-${g.id}`}>
              <legend>{g.legend}</legend>
              {g.fields.map((f) => (
                <div class="pa-field">
                  <label for={`pa-${f.id}`}>{f.label}</label>
                  {f.kind === 'multiline' ? (
                    <textarea id={`pa-${f.id}`} class="pa-input" data-field={f.id} maxlength={f.maxLength} rows={f.maxLines} lang="ko" autocomplete="off" spellcheck="false" aria-describedby={`pa-${f.id}-hint`}></textarea>
                  ) : (
                    <input id={`pa-${f.id}`} class="pa-input" type="text" data-field={f.id} maxlength={f.maxLength} lang="ko" autocomplete="off" spellcheck="false" enterkeyhint="next">
                  )}
                  {f.id === task.id && <p class="hint" id={`pa-${f.id}-hint`}>{task.maxLines}줄까지 쓸 수 있습니다.</p>}
                </div>
              ))}
            </fieldset>
          ))}
          <div class="pa-field pa-date">
            <label for={`pa-${date.id}`}>{date.label}</label>
            <input id={`pa-${date.id}`} class="pa-input" type="date" data-field={date.id} min="1900-01-01" max="2999-12-31" autocomplete="off">
          </div>
          <div class="notice pa-caution" id="pa-caution">
            <p>관공서에 따라 정해진 위임장 서식이 있어요. 내기 전에 그 기관에 확인하세요.</p>
            <p>인감증명서를 대신 받을 때는 <a href={GOV24_INGAM_URL} rel="noopener">정부24 인감증명서 발급 안내</a>에 있는 정해진 위임장을 쓰세요.</p>
          </div>
          <div class="row pa-actions">
            <button type="submit" class="btn primary" id="pa-make">위임장 만들기</button>
            <button type="button" class="btn ghost" id="pa-blank">빈 양식으로 받기</button>
            <button type="button" class="btn ghost" id="pa-reset">모두 지우기</button>
          </div>
          <p class="privacy-note">쓴 내용은 이 기기 밖으로 보내지 않습니다. <a href="/privacy/">개인정보 처리방침</a></p>
        </form>

        <div class="progress-box" id="pa-progress" hidden>
          <p id="pa-progress-text"></p>
          <progress id="pa-progress-bar" aria-labelledby="pa-progress-text"></progress>
        </div>

        <EngineError />
        <div class="error-box" id="pa-error" role="alert" tabindex="-1" hidden>
          <p id="pa-error-text"></p>
          <button type="button" class="btn ghost" id="pa-retry"></button>
        </div>

        <div class="pa-result" id="pa-result" tabindex="-1" aria-labelledby="pa-result-title" hidden>
          <h2 id="pa-result-title">만든 위임장</h2>
          <p class="notice warn" id="pa-stale" hidden></p>
          <div class="row pa-downloads" id="pa-downloads">
            {FORM_HWP && <button type="button" class="btn primary" id="pa-hwp">한글(HWP)로 받기</button>}
            <button type="button" class="btn primary" id="pa-pdf">PDF로 받기</button>
          </div>
          <p class="field-error" id="pa-hwp-error" role="alert"></p>
          <p class="field-error" id="pa-pdf-error" role="alert"></p>
          <p class="pa-done" id="pa-done"></p>
          <div class="next-steps" id="pa-next" role="group" aria-labelledby="pa-next-label" hidden></div>
          <div class="hw-preview pa-preview" id="pa-preview" tabindex="0" aria-label="미리 보기"></div>
        </div>
        <p class="visually-hidden" id="pa-status" aria-live="polite" data-live="status"></p>
      </div>

      <section class="pa-with" id="pa-with" aria-labelledby="pa-with-title">
        <h2 id="pa-with-title">함께 준비하는 것</h2>
        <ul>
          <li><a href="/id-copy/">신분증 사본 만들기</a></li>
          <li><a href="/stamp-maker/">도장 만들기</a></li>
          <li><a href="/pdf-merge/">PDF 합치기</a> <span>위임장과 신분증 사본을 한 파일로</span></li>
        </ul>
      </section>
    </div>
  </section>

  <QuickLinks slug={tool.slug} />

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">사용 방법</h2>
      <ol class="steps">
        <li><strong>칸 채우기</strong><span>위임하는 사람, 대리인, 위임할 일을 씁니다. 쓰지 않은 칸은 빈칸으로 남습니다.</span></li>
        <li><strong>위임장 만들기</strong><span>버튼을 누르면 위임장을 만들어 미리 보여 드립니다. 아무것도 쓰지 않으려면 「빈 양식으로 받기」를 누르세요.</span></li>
        <li><strong>받고 서명하기</strong><span>한글(HWP)이나 PDF로 받은 뒤 인쇄해서 위임인이 서명하거나 도장을 찍습니다.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">알아 두면 좋아요</h2>
      <ul class="points">
        <li><strong>정해진 서식이 있는 곳</strong><span>기관이 정한 위임장이 있으면 그 서식을 쓰세요. 이 도구로는 일반 위임장을 만들 수 있습니다.</span></li>
        <li><strong>가입·설치 없이 무료</strong><span>바로 만들어 받을 수 있고, 쓴 내용은 저장하지 않습니다.</span></li>
      </ul>
    </div>
  </section>

  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
          {f.links?.map((l) => <p><a href={l.href}>{l.text}</a></p>)}
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} only={['id-copy', 'stamp-maker', 'pdf-sign', 'pdf-merge']} />
  <aside class="tool-legal" aria-label="한글(HWP) 문서 관련 고지">
    <div class="wrap narrow">
      <p>{HANCOM_NOTICE}</p>
      <p>{TRADEMARK_NOTICE}</p>
    </div>
  </aside>
</Base>

<script>
  import '../../tools/power-of-attorney/entry';
</script>
