---
// /id-copy/ (TOOLS1015 I1): 신분증 사본 만들기. One photo of an ID card -> turned, cropped, opaque black boxes over what
// is not needed and a tiled 용도 문구, burned into one JPEG (and that JPEG on an A4 page as a PDF, through the 사진 PDF
// 변환 worker). The controller loads on the first interaction (entry.ts); pdf-lib only in the worker, on 사본 만들기.
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import AdSlot from '../../components/AdSlot.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import ToolNotes from '../../components/ToolNotes.astro';
import EngineError from '../../components/EngineError.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import OutLinks from '../../components/OutLinks.astro';
import { resultBlock } from '../../data/affiliate';
import { toolJsonLd } from '../../data/jsonld';
import { getTool } from '../../data/tools';
// Page-only styles, inlined (the /pdf-sign/ pattern): no other page carries them.
import icCss from '../../tools/id-copy/id-copy.css?inline';

const tool = getTool('id-copy');
// 제휴 링크 (AFF1029 A6: the Coupang 복합기 group, after the downloads): in the result (hidden until there is one).
const aff = resultBlock('id-copy', import.meta.env.PUBLIC_AFF_LINKPRICE, import.meta.env.PUBLIC_AFF_COUPANG);
const jsonLd = toolJsonLd(tool, Astro.site);
const accept = 'image/jpeg,image/png,image/webp,image/avif,.jpg,.jpeg,.png,.webp,.avif,.heic,.heif';
---
<Base title={tool.title} description={tool.description}>
  <JsonLd slot="head" data={jsonLd} />
  <style slot="head" is:inline set:html={icCss}></style>
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">신분증 사진에서 주민번호 뒤 7자리나 주소처럼 가릴 곳을 검은 상자로 가리고, 「회사 제출용」 같은 용도 문구를 넣어 JPG·PDF로 저장합니다.</p>
    </div>
  </section>

  <section class="tool" aria-label={`${tool.name} 도구`}>
    <div class="wrap narrow">
      <div id="ic-tool" class="merge" data-state="empty">
        <div class="drop" id="ic-drop">
          <input id="ic-input" class="file-input" type="file" accept={accept}>
          <label class="btn primary" for="ic-input" id="ic-pick">신분증 사진 선택</label>
          <p class="drop-hint">또는 여기에 사진을 끌어다 놓으세요 (JPG·PNG·아이폰 사진 등)</p>
          <p class="drop-hint-touch">휴대폰으로 신분증을 찍거나 사진 보관함에서 고를 수 있습니다.</p>
          <p class="privacy-note">사진은 이 기기 밖으로 보내지 않습니다. <a href="/privacy/">개인정보 처리방침</a></p>
        </div>

        <p class="error-box" id="ic-unsupported" role="alert" hidden>지금 쓰는 앱에서는 신분증 사본 만들기가 안 됩니다. Chrome·Safari·삼성 인터넷 등 다른 앱으로 이 페이지를 열어 주세요.</p>
        <EngineError />

        <div class="ic-editor" id="ic-editor" hidden>
          <div class="row ic-tools" role="group" aria-label="사진 고치기">
            <button type="button" class="btn ghost" id="ic-rotate">돌리기</button>
            <button type="button" class="btn ghost" id="ic-crop" aria-pressed="false">자르기</button>
            <button type="button" class="btn ghost" id="ic-add">가릴 곳 추가</button>
            <button type="button" class="btn ghost danger" id="ic-del" disabled>고른 상자 지우기</button>
          </div>
          <div class="ic-stage" id="ic-stage"><canvas id="ic-canvas" aria-hidden="true"></canvas></div>
          <p class="hint" id="ic-stage-hint">검은 상자를 끌어 옮기고, 오른쪽 아래 동그라미를 끌어 크기를 바꿉니다. 키보드로는 화살표로 옮기고, Shift+화살표로 크기를 바꾸고, Delete로 지웁니다.</p>

          <fieldset class="levels ic-mark">
            <legend>용도 문구</legend>
            <label for="ic-place">어디에 낼 건가요</label>
            <input id="ic-place" class="num-input ic-place" type="text" maxlength="30" autocomplete="off" placeholder="예: 회사 이름" aria-describedby="ic-mark-note">
            <label class="check"><input type="checkbox" id="ic-date" checked> 오늘 날짜 넣기</label>
            <p class="hint" id="ic-mark-note"></p>
          </fieldset>

          <div class="row merge-actions">
            <button type="button" class="btn primary" id="ic-run">사본 만들기</button>
            <input id="ic-change" class="file-input" type="file" accept={accept}>
            <label class="btn ghost" for="ic-change">다른 사진 고르기</label>
          </div>
        </div>

        <div class="progress-box" id="ic-progress" hidden>
          <p id="ic-progress-text">사본을 만드는 중…</p>
        </div>

        <div class="result" id="ic-result" hidden>
          <p class="result-title" id="ic-headline" tabindex="-1">사본이 준비되었습니다</p>
          <p class="result-summary" id="ic-summary"></p>
          <div class="row">
            <a class="btn primary" id="ic-jpg" download tabindex="0">JPG로 저장</a>
            <a class="btn primary" id="ic-pdf" download tabindex="0">PDF로 저장</a>
          </div>
          <OutLinks block={aff} />
          <div id="ic-next" class="next-steps" role="group" aria-labelledby="ic-next-label" hidden></div>
          <div class="row">
            <button type="button" class="btn ghost" id="ic-edit">다시 고치기</button>
            <button type="button" class="btn ghost" id="ic-reset">다른 사진으로 만들기</button>
          </div>
          <p class="save-name" id="ic-save-name"></p>
        </div>

        <p class="error-box" id="ic-error" role="alert" data-live="alert" hidden></p>
        <p class="visually-hidden" id="ic-status" aria-live="polite" data-live="status"></p>
      </div>
      <AdSlot id="id-copy-result" size="rect" />
    </div>
  </section>

  <QuickLinks slug={tool.slug} />

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">사용 방법</h2>
      <ol class="steps">
        <li><strong>사진 고르기</strong><span>신분증을 찍은 사진을 고릅니다. 필요하면 돌리고 신분증만 남게 자릅니다.</span></li>
        <li><strong>가리고 문구 넣기</strong><span>가릴 곳 추가로 검은 상자를 놓고, 어디에 낼지 적으면 용도 문구가 사진 전체에 들어갑니다.</span></li>
        <li><strong>저장하기</strong><span>사본 만들기를 누른 뒤 JPG나 PDF로 저장합니다.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">알아 두면 좋아요</h2>
      <ul class="points">
        <li><strong>가린 곳은 다시 볼 수 없어요</strong><span>검은 상자는 사진 위에 올리는 것이 아니라 사진 자체를 칠해 저장합니다. 촬영 날짜·위치 같은 사진 정보도 남지 않습니다.</span></li>
        <li><strong>받는 곳에 먼저 물어보세요</strong><span>받는 곳이 꼭 필요하다고 하지 않은 정보는 가려도 되는지 먼저 물어보세요.</span></li>
      </ul>
    </div>
  </section>

  <ToolNotes slug={tool.slug} />


  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
          {f.links?.map((l) => <p><a href={l.href}>{l.text}</a></p>)}
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} only={['jpg-to-pdf', 'photo-compress', 'pdf-password', 'power-of-attorney']} />
  <div class="wrap narrow"><AdSlot id="id-copy-footer" size="leaderboard" /></div>
</Base>

<script>
  import '../../tools/id-copy/entry';
</script>
