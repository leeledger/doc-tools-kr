---
// /english-address/ (ADDREN1016): 영문주소 변환기. Injected by astro.config.mjs only when PUBLIC_ADDR_EN is on. The typed
// address goes to the same-origin /api/addr-en (functions/api/addr-en.ts -> 행정안전부 영문주소 검색) when 찾기 is
// pressed; the 상세주소 is converted on this device. Nothing is stored: the search input has no name (a submit before
// the script runs puts nothing in the URL), and the controller keeps the query only in memory. Every string on this
// page is in the preloaded UI font (CORE_PATHS); the results and the split card are built by the controller (late).
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import ToolNotes from '../../components/ToolNotes.astro';
import QuickLinks from '../../components/QuickLinks.astro';
import { faqJsonLd, toolJsonLd } from '../../data/jsonld';
import { getTool } from '../../data/tools';
// Page-only styles, inlined (the /char-count/ pattern): no other page carries them.
import eaCss from './english-address.css?inline';

const tool = getTool('english-address');
const jsonLd = [...toolJsonLd(tool, Astro.site), faqJsonLd(tool)];
/** V7: 주소정보누리집 「도로명주소 영문 표기방법」 (fetched 2026-10-16). */
const NOTATION = 'https://www.juso.go.kr/introduction/RoadAddress';
---
<Base title={tool.title} description={tool.description}>
  <JsonLd slot="head" data={jsonLd} />
  <style slot="head" is:inline set:html={eaCss}></style>
  <section class="tool-hero" aria-labelledby="tool-title">
    <div class="wrap narrow">
      <h1 id="tool-title">{tool.h1}</h1>
      <p class="lead">주소를 찾아 영문 도로명주소로 바꿔요. 해외 직구 주소 칸(Address·City·State·ZIP)에 넣을 값을 칸마다 복사할 수 있어요.</p>
    </div>
  </section>

  <section class="tool" aria-label={`${tool.name} 도구`}>
    <div class="wrap narrow">
      <div id="ea-tool">
        <form id="ea-form" class="ea-form" role="search" novalidate>
          <label for="ea-q">영문으로 바꿀 주소</label>
          <div class="ea-row">
            <input id="ea-q" class="ea-input" type="search" enterkeyhint="search" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="예: 세종대로 110, 반포동 18-1" aria-describedby="ea-privacy ea-msg" />
            <button type="submit" class="btn primary" id="ea-go">찾기</button>
          </div>
          <p class="privacy-note" id="ea-privacy">찾는 주소는 행정안전부 주소 검색으로 보내 영문 주소를 받아 와요. 문서딱은 저장하지 않아요. <a href="/privacy/#addr">개인정보 처리방침</a></p>
        </form>
        <noscript><p class="ea-msg">이 도구는 지금 쓰는 앱에서 열리지 않아요. 다른 인터넷 앱으로 열어 주세요.</p></noscript>
        <p class="ea-msg" id="ea-msg" aria-live="polite"></p>
        <div id="ea-results" aria-live="polite"></div>
        <div id="ea-split"></div>
        <p class="ea-source">주소 자료: <a href="https://www.juso.go.kr/" rel="noopener">행정안전부 도로명주소 (주소정보누리집)</a></p>
        <p class="visually-hidden" id="ea-live" aria-live="polite"></p>
      </div>
    </div>
  </section>

  <QuickLinks slug={tool.slug} />

  <section class="howto" aria-labelledby="howto-title">
    <div class="wrap narrow">
      <h2 id="howto-title">사용 방법</h2>
      <ol class="steps">
        <li><strong>주소 찾기</strong><span>도로명과 건물 번호나 동 이름과 번지를 적고 찾기를 누릅니다.</span></li>
        <li><strong>맞는 주소 고르기</strong><span>찾은 주소 가운데 내 주소를 골라 「이 주소 쓰기」를 누릅니다. 동·호가 있으면 적어 넣습니다.</span></li>
        <li><strong>칸마다 복사하기</strong><span>해외 직구 주소 칸에 맞춰 나눈 값을 하나씩 복사해 붙여 넣습니다.</span></li>
      </ol>
    </div>
  </section>

  <section class="why" aria-labelledby="why-title">
    <div class="wrap narrow">
      <h2 id="why-title">알아 두면 좋아요</h2>
      <ul class="points">
        <li><strong>영문 주소는 작은 단위부터 써요</strong><span>동·호, 건물 번호와 도로명, 시나 구, 시·도, 우편번호 순서예요. 주소 칸이 여러 개면 칸마다 나눠 넣으면 돼요.</span></li>
        <li><strong>아파트 이름은 빼도 돼요</strong><span>행정안전부 영문 표기 안내는 주소를 간결하게 하려고 아파트 이름 같은 참고 항목을 쓰지 않아도 된다고 해요. <a href={NOTATION} rel="noopener">행정안전부: 도로명주소 영문 표기방법</a></span></li>
      </ul>
    </div>
  </section>

  <ToolNotes slug={tool.slug} />


  <section class="faq" aria-labelledby="faq-title">
    <div class="wrap narrow">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {tool.faq.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
          {f.links?.map((l) => <p><a href={l.href}>{l.text}</a></p>)}
        </details>
      ))}
    </div>
  </section>
  <RelatedTools current={tool.slug} only={['id-photo', 'pdf-merge', 'business-card']} />
</Base>

<script>
  import './entry';
</script>
