---
// The 여권·증명사진 tool body (REV5 R5.1): /id-photo/ and the embed widget /embed/id-photo/ render the same markup.
// embed (REV5 Decision 3) leaves out what does not belong inside a host site's frame: the 인화·사진관 and affiliate
// links, the share buttons, 이어서 하기 and the ad slot; the privacy link opens in a new tab instead of the frame.
import AdSlot from './AdSlot.astro';
import EngineError from './EngineError.astro';
import Share from './Share.astro';
import OutLinks from './OutLinks.astro';
import { getTool } from '../data/tools';
import { sharePreview } from '../data/site';
import { PRINT_COPY, printLinks } from '../data/print-links';
import { affBlock, affOn } from '../data/affiliate';
import { CUSTOM_BOUNDS, DEFAULT_PRESET, PASSPORT_CHECK_URL, PASSPORT_RULE_URL, PRESETS, PRESET_GROUPS, RETRIEVED } from '../data/id-photo-presets';

interface Props {
  embed?: boolean;
}
const { embed = false } = Astro.props;

const tool = getTool('id-photo');
const autoframe = __ID_PHOTO_AUTOFRAME__;
// IDCAM1022 D10: the 「카메라로 찍기」 link only where /id-photo-camera/ is built.
const camera = !embed && __ID_CAMERA__;
// 인화·사진관 링크 (REV2): PUBLIC_PRINT_INFO=0 drops the info link; PUBLIC_AFF_COUPANG=1 adds the affiliate group (REV3: OutLinks).
const infoLinks = embed ? [] : printLinks({ PUBLIC_PRINT_INFO: import.meta.env.PUBLIC_PRINT_INFO });
const aff = embed ? null : affBlock('tool', 'id-photo', affOn(import.meta.env.PUBLIC_AFF_COUPANG));
const accept = 'image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp';
const notices = [
  '이 도구는 자르기·기울기 조정·크기 조정·재압축만 합니다. 얼굴·피부·배경을 수정하지 않습니다.',
  null,
  '배경을 흰색으로 바꾸거나 지우지 않습니다. 배경이 흰색이 아니면 흰 배경에서 다시 찍어 주세요.',
  '머리 길이는 추정값입니다. 머리카락에 가려진 정수리 위치는 사진으로 정확히 알 수 없으니 안내선을 보고 직접 확인하세요.',
  '최종 적합 여부는 접수 기관 심사로 결정되며, 이 도구는 통과를 보장하지 않습니다.',
];
const nudges = [
  { label: '위로 이동', d: '0,-1', path: 'M12 5l-6 7h4v7h4v-7h4z' },
  { label: '아래로 이동', d: '0,1', path: 'M12 19l6-7h-4V5h-4v7H6z' },
  { label: '왼쪽으로 이동', d: '-1,0', path: 'M5 12l7-6v4h7v4h-7v4z' },
  { label: '오른쪽으로 이동', d: '1,0', path: 'M19 12l-7 6v-4H5v-4h7V6z' },
];
---
  <section class="tool" aria-label="여권·증명사진 규격 맞추기 도구">
    <div class="wrap narrow">
      <div id="idp-tool" class="idp" data-state="empty">
        <div class="ph-field idp-preset">
          <label for="idp-preset">제출처</label>
          <select id="idp-preset" class="select" aria-describedby="idp-source">
            {PRESET_GROUPS.map((group) => {
              const items = PRESETS.filter((p) => p.group === group);
              const custom = group === '기타';
              return items.length || custom ? (
                <optgroup label={group}>
                  {items.map((p) => <option value={p.id} selected={p.id === DEFAULT_PRESET}>{p.label}</option>)}
                  {custom && <option value="custom">직접 입력</option>}
                </optgroup>
              ) : null;
            })}
          </select>
          <div class="idp-custom" id="idp-custom" hidden>
            <div class="ph-custom">
              <label for="idp-w">가로</label>
              <input class="num-input" id="idp-w" type="text" inputmode="numeric" autocomplete="off" value="413" aria-describedby="idp-custom-error">
              <span>픽셀</span>
            </div>
            <div class="ph-custom">
              <label for="idp-h">세로</label>
              <input class="num-input" id="idp-h" type="text" inputmode="numeric" autocomplete="off" value="531" aria-describedby="idp-custom-error">
              <span>픽셀</span>
            </div>
            <div class="ph-custom">
              <label for="idp-kb">용량 한도 (선택)</label>
              <input class="num-input" id="idp-kb" type="text" inputmode="numeric" autocomplete="off" aria-describedby="idp-custom-error">
              <span>KB 이하</span>
            </div>
            <p class="level-desc">가로·세로 {CUSTOM_BOUNDS.minPx}–{CUSTOM_BOUNDS.maxPx.toLocaleString('ko-KR')} 픽셀(px), 용량 {CUSTOM_BOUNDS.minKb}–{CUSTOM_BOUNDS.maxKb.toLocaleString('ko-KR')} KB로 입력합니다.</p>
            <p class="field-error" id="idp-custom-error"></p>
          </div>
          <p class="level-desc idp-source" id="idp-source">기준일 {RETRIEVED} · 출처: <a href={PRESETS[0]!.sourceUrls[0]} rel="noopener noreferrer" target="_blank">{PRESETS[0]!.source} (새 창)</a></p>
          <p class="level-desc">기관 안내가 바뀌었을 수 있습니다. 제출 전에 제출처 안내를 꼭 확인하세요.</p>
        </div>

        <div class="drop" id="idp-drop">
          <p class="idp-privacy">사진은 이 기기 밖으로 전송되지 않습니다. {embed ? <a href="/privacy/" rel="noopener" target="_blank">개인정보 처리방침 (새 창)</a> : <a href="/privacy/">개인정보 처리방침</a>}</p>
          <input id="idp-input" class="file-input" type="file" accept={accept}>
          <label class="btn primary" for="idp-input" id="idp-pick">사진 선택</label>
          {/* IDCAM1022 D1: the camera page, with this preset (entry.ts keeps ?preset= in step); not in the embed widget. */}
          {camera && <a class="btn ghost" id="idp-camera" href="/id-photo-camera/">카메라로 찍기</a>}
          <p class="drop-hint">또는 여기에 사진 한 장을 끌어다 놓으세요 (JPG·PNG·WebP)</p>
          <p class="drop-hint-touch">휴대폰의 사진 보관함이나 「파일」 앱에서 고를 수 있습니다 (JPG·PNG·WebP).</p>
          {autoframe && <p class="privacy-note" id="idp-download-note">얼굴 위치 자동 맞춤을 위해 처음 한 번 약 6 MB의 프로그램 파일을 내려받습니다. 사진은 보내지 않습니다.</p>}
        </div>

        <p class="error-box" id="idp-error" role="alert" data-live="alert" hidden></p>
        {/* 이어서 하기 receiver (IDCAM1022 D2): 「방금 만든 파일을 가져왔습니다.」 when a photo was handed over. */}
        {!embed && <p class="notice" id="idp-notice" hidden></p>}

        <div class="progress-box" id="idp-loading" hidden>
          <p id="idp-loading-text">사진을 여는 중입니다</p>
          <progress id="idp-loading-bar" aria-labelledby="idp-loading-text"></progress>
          {autoframe && <button type="button" class="btn ghost" id="idp-skip" hidden>건너뛰고 직접 맞추기</button>}
        </div>

        <EngineError />

        <div class="idp-adjust" id="idp-adjust" hidden>
          <div class="idp-stage" id="idp-stage" tabindex="0" role="group" aria-label="사진 위치 조정. 화살표 키로 이동, +와 −로 확대·축소, [와 ]로 기울기 조정" aria-describedby="idp-readout">
            <canvas id="idp-photo" aria-hidden="true"></canvas>
            <canvas id="idp-overlay" aria-hidden="true"></canvas>
          </div>
          <p class="idp-readout" id="idp-readout"></p>

          <div class="idp-controls">
            <div class="ph-range">
              <label for="idp-zoom">확대·축소</label>
              <input id="idp-zoom" type="range" min="0" max="1000" step="1" value="500">
            </div>
            <div class="ph-range">
              <label for="idp-rot">기울기</label>
              <input id="idp-rot" type="range" min="-5" max="5" step="0.5" value="0" aria-describedby="idp-rot-help">
              <output id="idp-rot-out" for="idp-rot">0.0°</output>
            </div>
            <p class="level-desc" id="idp-rot-help">사진 전체가 기울어졌을 때만 쓰세요. 고개가 기울어졌다면 다시 찍는 것이 좋습니다.</p>
            <div class="idp-nudges" role="group" aria-label="사진 위치 옮기기">
              {nudges.map((n) => (
                <button type="button" class="btn ghost icon-btn idp-nudge" data-nudge={n.d} aria-label={n.label}>
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d={n.path} fill="currentColor" /></svg>
                </button>
              ))}
              <button type="button" class="btn ghost" id="idp-reset">{autoframe ? '자동 맞춤으로 되돌리기' : '처음 위치로'}</button>
            </div>
          </div>

          <h2 class="idp-h2" id="idp-check-title">확인 목록</h2>
          <ul class="idp-checklist" id="idp-checklist" aria-labelledby="idp-check-title"></ul>

          <div class="notice idp-notices" role="note" aria-label="꼭 읽어 주세요">
            <ol>
              {notices.map((t, i) =>
                i === 1 ? (
                  <li>
                    외교부 안내: 「사진 편집 프로그램, 사진 필터 기능 등을 사용하여 임의로 보정된 사진(AI를 활용한 편집·가공·합성·창조 제작물 포함)은 허용 불가함」{' '}
                    <a href={PASSPORT_RULE_URL} rel="noopener noreferrer" target="_blank" aria-label={`외교부 여권사진 규격 안내, ${RETRIEVED} 기준 (새 창)`}>({RETRIEVED} 기준)</a>
                  </li>
                ) : (
                  <li>{t}</li>
                ),
              )}
              <li>
                여권 사진은 제출 전에 외교부 「온라인 여권 사진 검증」에서 한 번 더 확인할 수 있습니다. (외교부 사이트로 이동하며, 그곳에서는 사진을 외교부로 보냅니다.){' '}
                <a id="idp-verify-link" href={PASSPORT_CHECK_URL} rel="noopener noreferrer" target="_blank">온라인 여권 사진 검증 (새 창)</a>
              </li>
            </ol>
          </div>

          <label class="check idp-confirm-label"><input type="checkbox" id="idp-confirm"><span>규격 확인은 제출처 기준을 따릅니다. 정수리(머리카락 제외)와 턱 위치를 안내선에서 직접 확인했습니다.</span></label>
          <div class="row idp-save-row">
            <button type="button" class="btn primary" id="idp-save" disabled aria-describedby="idp-save-reason">규격에 맞춰 저장</button>
          </div>
          <p class="hint" id="idp-save-reason"></p>
        </div>

        <div class="progress-box" id="idp-exporting" hidden>
          <p id="idp-exporting-text">규격에 맞춰 저장하는 중입니다</p>
          <progress aria-labelledby="idp-exporting-text"></progress>
        </div>

        <div class="idp-done" id="idp-done" hidden>
          <p class="result-title" id="idp-headline" tabindex="-1"></p>
          <ul class="idp-chips" id="idp-chips" aria-label="맞춘 규격"></ul>
          <div class="row">
            <a class="btn primary" id="idp-download" tabindex="0">내려받기</a>
          </div>
          {!embed && <div id="idp-next" class="next-steps" role="group" aria-labelledby="idp-next-label" hidden></div>}
          <p class="save-name" id="idp-save-name"></p>
          <p class="notice" id="idp-print" hidden></p>
          {!embed && <p class="notice" id="idp-english" hidden></p>}
          {(infoLinks.length > 0 || aff) && (
            <div class="out-links" id="idp-print-links">
              <p>{PRINT_COPY.lead}</p>
              {infoLinks.length > 0 && (
                <ul>
                  {infoLinks.map((l) => <li><a href={l.href} rel="noopener noreferrer" target="_blank" data-out={l.dest}>{l.label}</a></li>)}
                </ul>
              )}
              <OutLinks block={aff} />
            </div>
          )}
          {!embed && <Share name={tool.name} text={sharePreview('/id-photo/', Astro.site!).description} id="idp-share" />}
          <p class="notice" id="idp-fallback" hidden></p>
          <div class="row">
            <button type="button" class="btn ghost" id="idp-again">다른 규격으로 다시 만들기</button>
            <button type="button" class="btn ghost" id="idp-new">다른 사진 처리하기</button>
          </div>
          <p class="level-desc">자르기·기울기 조정·크기 조정·재압축만 했습니다. 얼굴·피부·배경은 그대로입니다.</p>
          <figure class="idp-result-box">
            <img id="idp-result" alt="" decoding="async">
            <figcaption><label class="check"><input type="checkbox" id="idp-zoom2"><span>2배로 보기</span></label></figcaption>
          </figure>
        </div>

        <p class="visually-hidden" id="idp-status" aria-live="polite" data-live="status"></p>
      </div>
      {!embed && <AdSlot id="id-photo-result" size="rect" />}
    </div>
  </section>

<script>
  // Here, not in each page: both pages then load this one script file. With a script per page, entry.ts became a
  // chunk of its own and the /id-photo/ script a one-line import of it, one more hop (Lighthouse LCP 1,664 -> 1,822 ms
  // local; here 1,663). Module scripts run after parsing, so the tag's place in <main> changes nothing else.
  import '../tools/id-photo/entry';
</script>
