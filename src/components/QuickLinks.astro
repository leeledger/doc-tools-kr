---
// "자주 쓰는 규격" (Growth G.6) and "관련 안내" on a tool page: below the tool, above the FAQ.
import { quickLinks } from '../data/quicklinks';
import { guidePath, guidesForTool } from '../data/guides';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const links = quickLinks(slug);
const guides = await guidesForTool(slug);
---
{(links.length > 0 || guides.length > 0) && (
  <section class="quick" aria-labelledby="quick-title">
    <div class="wrap narrow">
      {links.length > 0 && (
        <>
          <h2 id="quick-title">자주 쓰는 규격</h2>
          <ul class="quick-list">
            {links.map((l) => <li><a data-deeplink data-name={l.name} href={l.href}>{l.label}</a></li>)}
          </ul>
        </>
      )}
      {guides.length > 0 && (
        <>
          {links.length > 0 ? <h3 class="quick-sub">관련 안내</h3> : <h2 id="quick-title">관련 안내</h2>}
          <ul class="quick-guides">
            {guides.map((g) => <li><a href={guidePath(g.id)}>{g.data.title}</a></li>)}
          </ul>
        </>
      )}
    </div>
  </section>
)}
