---
// A /guide/ page (Growth G.1). Blocks in order: H1, the answer with its source and date, share, the tool
// button, the body, the FAQ, related guides, the tools, and every source with its date. Official quotes stay
// in the frontmatter (the audit trail) and are never rendered.
import Base from './Base.astro';
import '../styles/guide.css';
import Share from '../components/Share.astro';
import { SITE } from '../data/site';
import { LIVE_TOOLS } from '../data/tools';
import { guideJsonLd, guideOgUrl } from '../data/jsonld';
import { resolveSources } from '../data/guide-facts';
import { guidePath, guidesBySlug, type Guide } from '../data/guides';

interface Props {
  guide: Guide;
}
const { guide } = Astro.props;
const g = guide.data;
const slug = guide.id;
const canonical = new URL(guidePath(slug), Astro.site).href;
const sources = resolveSources(g.sources);
const first = sources[0]!;
const related = await guidesBySlug(g.related, slug);
const tools = g.tools.map((s) => LIVE_TOOLS.find((t) => t.slug === s)!).filter(Boolean);
const jsonLd = guideJsonLd(
  { slug, title: g.title, description: g.description, published: g.published, updated: g.updated, faq: g.faq, citations: sources.map((s) => s.url) },
  Astro.site,
);
const ext = { rel: 'noopener noreferrer', target: '_blank' };
---
<Base
  title={`${g.title} | ${SITE.name}`}
  description={g.description}
  ogImage={guideOgUrl(slug, Astro.site)}
  ogAlt={`${SITE.name}: ${g.og.title} — ${g.og.line}`}
  ogDescription={g.ogDescription}
  ogType="article"
  jsonLd={jsonLd}
  rss
>
  <div class="guide-page">
    <article class="guide wrap narrow" aria-labelledby="guide-title">
      <p class="guide-crumbs"><a href="/guide/">안내</a> · {g.category}</p>
      <h1 id="guide-title">{g.title}</h1>
      <div class="guide-answer-box">
        <p class="guide-answer">{g.answer}</p>
        <p class="guide-source">출처: <a href={first.url} {...ext}>{first.title}</a> · 확인일 <time datetime={first.retrieved}>{first.retrieved}</time></p>
      </div>
      <Share name={g.title} text={g.ogDescription} id="guide-share" url={canonical} />
      <p class="guide-cta"><a class="btn primary" href={g.cta.href}>{g.cta.label}</a></p>
      <div class="guide-body">
        <slot />
      </div>
      <section class="guide-faq" aria-labelledby="guide-faq-title">
        <h2 id="guide-faq-title">자주 묻는 질문</h2>
        {g.faq.map((f) => (
          <div class="guide-qa">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </section>
    </article>
    <aside class="guide-more wrap narrow" aria-label="더 보기">
      {related.length > 0 && (
        <section aria-labelledby="guide-related-title">
          <h2 id="guide-related-title">함께 보면 좋은 안내</h2>
          <ul class="related-list">
            {related.map((r) => <li><a href={guidePath(r.id)}>{r.data.title}</a></li>)}
          </ul>
        </section>
      )}
      <section aria-labelledby="guide-tools-title">
        <h2 id="guide-tools-title">바로 쓰는 도구</h2>
        <ul class="related-list">
          {tools.map((t) => (
            <li>
              <a href={`/${t.slug}/`}>{t.name}</a>
              <span>{t.summary}</span>
            </li>
          ))}
        </ul>
      </section>
      <section class="guide-sources" aria-labelledby="guide-sources-title">
        <h2 id="guide-sources-title">확인일과 출처</h2>
        <ul>
          {sources.map((s) => (
            <li><a href={s.url} {...ext}>{s.title} (새 창)</a> · 확인일 <time datetime={s.retrieved}>{s.retrieved}</time></li>
          ))}
        </ul>
        <p class="guide-note">규격은 기관 사정에 따라 바뀔 수 있어요. 내기 전에 원문을 한 번 더 확인해 주세요.</p>
        <p class="guide-dates">처음 쓴 날 <time datetime={g.published}>{g.published}</time> · 고친 날 <time datetime={g.updated}>{g.updated}</time></p>
      </section>
    </aside>
  </div>
</Base>
