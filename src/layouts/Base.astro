---
import '../generated/anolim-ui.css';
import '../styles/global.css';
import '../styles/app.css';
import { SITE, VERIFICATION, defaultDescription, footerContact, sharePreview } from '../data/site';
import { BUILD_ID } from '../data/build';
import { LIVE_TOOLS } from '../data/tools';
import JsonLd from '../components/JsonLd.astro';
// Preloaded UI weights (Polish P.12): 400 (body) and 800 (every H1). 700 loads on demand. There is no 600 face: a
// fourth file on the critical path put home LCP over 2,000 ms (G2 ci-green; BUILD-LOG).
import uiFont400 from '../generated/anolim-ui-400.woff2?url';
import uiFont800 from '../generated/anolim-ui-800.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** Id the skip link jumps to. */
  skipTarget?: string;
  isHome?: boolean;
  noindex?: boolean;
  /** Share image (absolute URL) and its alt text; default: the page's og.json image (Growth G: guides have their own). */
  ogImage?: string;
  ogAlt?: string;
  /** og:description and twitter:description; default: og.json. */
  ogDescription?: string;
  ogType?: 'website' | 'article';
  /** JSON-LD blocks for the head. */
  jsonLd?: Record<string, unknown>[];
  /** The guide RSS feed as a head alternate link (/guide/ and every guide). */
  rss?: boolean;
}

const {
  title = SITE.defaultTitle,
  description = defaultDescription(),
  skipTarget = 'main',
  isHome = false,
  noindex = false,
  ogType = 'website',
  jsonLd,
  rss = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const preview = sharePreview(Astro.url.pathname, Astro.site!);
const share = {
  image: Astro.props.ogImage ?? preview.image,
  alt: Astro.props.ogAlt ?? preview.alt,
  description: Astro.props.ogDescription ?? preview.description,
};
const nav = isHome ? '' : '/';
const path = Astro.url.pathname;
const footOp = footerContact();
const favicon =
  "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%230f766e'/%3E%3Cpath d='M10 9h8l4 4v10H10z' fill='none' stroke='white' stroke-width='2' stroke-linejoin='round'/%3E%3Cpath d='M13 18l2.5 2.5L20 16' fill='none' stroke='white' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
{noindex && <meta name="robots" content="noindex">}
{!noindex && <link rel="canonical" href={canonical}>}
<meta name="build-id" content={BUILD_ID}>
<meta name="theme-color" content={SITE.themeColor}>
<meta property="og:type" content={ogType}>
<meta property="og:locale" content={SITE.locale}>
<meta property="og:site_name" content={SITE.name}>
<meta property="og:title" content={title}>
<meta property="og:description" content={share.description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={share.image}>
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={share.alt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={share.description}>
<meta name="twitter:image" content={share.image}>
<meta name="twitter:image:alt" content={share.alt}>
{VERIFICATION.naver && <meta name="naver-site-verification" content={VERIFICATION.naver}>}
{VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google}>}
<link rel="icon" href={favicon} type="image/svg+xml">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="apple-touch-icon" href="/brand/apple-touch-icon.png">
<link rel="manifest" href="/manifest.webmanifest">
{rss && <link rel="alternate" type="application/rss+xml" title={`${SITE.name} 안내`} href="/guide/rss.xml">}
<link rel="preload" href={uiFont400} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={uiFont800} as="font" type="font/woff2" crossorigin>
{jsonLd && <JsonLd data={jsonLd} />}
<slot name="head" />
</head>
<body>
<a class="skip" href={`#${skipTarget}`}>본문으로 건너뛰기</a>

<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} 홈`}>
      <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="currentColor"/><path d="M10 9h8l4 4v10H10z" fill="none" stroke="#fff" stroke-width="2" stroke-linejoin="round"/><path d="M13 18l2.5 2.5L20 16" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span>{SITE.name}</span>
    </a>
    <nav aria-label="주요 메뉴" class="top-nav">
      <div class="menu" data-menu>
        {/* Without JS this stays a link to the tool list; the site script turns it into the disclosure button. */}
        <a class="menu-toggle" href="/#tools" data-menu-toggle>도구</a>
        <div class="menu-panel" id="tools-menu" hidden>
          <ul>
            {LIVE_TOOLS.map((t) => (
              <li>
                <a href={`/${t.slug}/`} aria-current={path === `/${t.slug}/` ? 'page' : undefined}>
                  <svg viewBox="0 0 24 24" aria-hidden="true" set:html={t.icon} />
                  <span>{t.name}</span>
                </a>
              </li>
            ))}
            <li class="menu-sep"><a href="/#privacy">보안</a></li>
            <li><a href="/#faq">자주 묻는 질문</a></li>
          </ul>
        </div>
      </div>
      <a class="nav-guide" href="/guide/" aria-current={path.startsWith('/guide/') ? 'page' : undefined}>안내</a>
      <a class="nav-extra" href={`${nav}#privacy`}>보안</a>
      <a class="nav-extra" href={`${nav}#faq`}>자주 묻는 질문</a>
    </nav>
  </div>
</header>

<main id="main">
<slot />
</main>

<footer class="foot">
  <div class="wrap foot-inner">
    {footOp && <p class="foot-op" set:html={footOp} />}
    <nav class="foot-links" aria-label="사이트 정보">
      <a href="/guide/">안내</a>
      <a href="/terms/">이용약관</a>
      <a href="/privacy/">개인정보 처리방침</a>
      <a href="/licenses/">오픈소스 라이선스</a>
    </nav>
    <p class="foot-copy">© 2026 {SITE.name} · {SITE.tagline}</p>
  </div>
</footer>
<script>
  import '../lib/ui/site';
</script>
</body>
</html>
